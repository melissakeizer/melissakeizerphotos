---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  theme?: 'light' | 'dark';
  hideNav?: boolean;
  brandImage?: string;
}

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');
const { title = 'Photography by Melissa Keizer', description = 'Freelance pet & event photographer based in Bangor, Northern Ireland.', image, theme = 'light', hideNav = false, brandImage = 'melissa-keizer-sticker.png' } = Astro.props;
const fullTitle = title === 'Photography by Melissa Keizer' ? title : `${title} — Melissa Keizer Photography`;
const pathname = Astro.url.pathname;
const storiesActive = pathname.includes('/stories');
const photoStreamActive = pathname.includes('/field-notes');
const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/jpeg" href={`${base}photos/sky-odin/000-ph_log7wlnpvdpmhx0i.jpg`} />
  </head>
  <body>
    <nav class="site-nav" class:list={[{ 'site-nav--hidden': hideNav }]} aria-label="Primary navigation">
      <a class:list={['site-nav__brand', { 'site-nav__brand--sticker': brandImage }]} href={base} aria-label="Melissa Keizer Photography home">
        <img src={`${base}${brandImage}`} alt="" />
      </a>
      <div class="site-nav__links">
        <a class:list={{ 'is-active': storiesActive }} href={`${base}stories/`} aria-current={storiesActive ? 'page' : undefined}>Stories</a>
        <a class:list={{ 'is-active': photoStreamActive }} href={`${base}field-notes/`} aria-current={photoStreamActive ? 'page' : undefined}>PhotoStream</a>
        <a href="#contact">Contact</a>
      </div>
    </nav>
    {isDev && (
      <>
        <button class="debug-grid-toggle" type="button" aria-pressed="true" data-debug-grid-toggle>Hide grid</button>
        <div class="debug-grid" aria-hidden="true" data-debug-grid>
          {Array.from({ length: 12 }, (_, index) => <span>{index + 1}</span>)}
        </div>
      </>
    )}
    <slot />
    <footer class="site-footer" id="contact" style={`--footer-photo: url('${base}photos/road-to-sligo/000-photo.jpg')`}>
      <div class="site-footer__panel">
        <div class="site-footer__portrait">
          <img src={`${base}melissa-keizer-avatar.jpeg`} alt="Melissa Keizer" />
        </div>
        <div class="site-footer__introduction">
          <p class="site-footer__label">About me</p>
          <p class="site-footer__introduction-copy">
            <strong>Hi, I’m Melissa Keizer.</strong>
            <span>I’m a photographer and product designer based in Bangor, Northern Ireland. Usually found following dogs into good light or making one more tiny adjustment in Lightroom.</span>
          </p>
        </div>
        <nav class="site-footer__links" aria-label="Explore">
          <p class="site-footer__label">Explore</p>
          <a href={base}>Home</a>
          <a href={`${base}stories/`}>All posts</a>
          <a href={`${base}field-notes/`}>PhotoStream</a>
          <a href="mailto:hi@melissakeizer.com">Email</a>
        </nav>
        <nav class="site-footer__social-links" aria-label="Social media">
          <a href="https://www.linkedin.com/in/melissakeizer/" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href="https://www.instagram.com/KeizGoesBoom/" target="_blank" rel="noreferrer">Instagram</a>
          <a href="https://unsplash.com/@KeizGoesBoom" target="_blank" rel="noreferrer">Unsplash</a>
        </nav>
        <div class="site-footer__equipment-space" aria-hidden="true">
          <img src={`${base}lens-sketch-zeiss-55mm-v3.png`} alt="" />
        </div>
      </div>
    </footer>
    {isDev && (
      <script is:inline>
        (() => {
          const button = document.querySelector('[data-debug-grid-toggle]');
          const grid = document.querySelector('[data-debug-grid]');
          if (!(button instanceof HTMLButtonElement) || !(grid instanceof HTMLElement)) return;

          const stored = localStorage.getItem('mk-debug-grid');
          let visible = stored !== 'hidden';
          const render = () => {
            grid.hidden = !visible;
            button.textContent = visible ? 'Hide grid' : 'Show grid';
            button.setAttribute('aria-pressed', String(visible));
          };

          button.addEventListener('click', () => {
            visible = !visible;
            localStorage.setItem('mk-debug-grid', visible ? 'visible' : 'hidden');
            render();
          });
          render();
        })();
      </script>
    )}
  </body>
</html>
