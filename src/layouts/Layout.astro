---
import '../styles/global.css';
import '../styles/typography.css';
import '../styles/tablet.css';
import '../styles/entrances.css';
import '../styles/media-loading.css';
import SiteFooter from '../components/SiteFooter.astro';
import Fonts from '../components/Fonts.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  theme?: 'light' | 'dark';
  hideNav?: boolean;
  brandImage?: string;
}

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');
const { title = 'Photography by Melissa Keizer', description = 'Freelance pet & event photographer based in Bangor, Northern Ireland.', image, theme = 'light', hideNav = false, brandImage = 'melissa-keizer-sticker.png' } = Astro.props;
const fullTitle = title === 'Photography by Melissa Keizer' ? title : `${title} — Melissa Keizer Photography`;
const pathname = Astro.url.pathname;
const storiesActive = pathname.includes('/stories') || pathname.includes('/posts');
const photoStreamActive = pathname.includes('/photostream') || pathname.includes('/field-notes');
const homeActive = pathname.replace(/\/$/, '') === base.replace(/\/$/, '');
const palette = homeActive || pathname.includes('/photostream/') || pathname.includes('/previews/homepage/')
  ? 'warm-dark' : pathname.includes('/posts') ? 'warm-light' : undefined;
const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="en" data-theme={theme} data-palette={palette}>
  <head>
    <Fonts />
    <script is:inline>
      if (window.CSS && CSS.supports('translate', '0')) document.documentElement.classList.add('camera-draw-enabled');
    </script>
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window && window.CSS && CSS.supports('selector(:where(*))') && CSS.supports('translate', '0')) {
        document.documentElement.classList.add('entrances-enabled');
        // Fail open if the page script cannot load.
        window.entranceFallback = setTimeout(() => document.documentElement.classList.remove('entrances-enabled'), 4000);
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href={`${base}favicon-32.png`} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} sizes="180x180" />
  </head>
  <body>
    <nav class="site-nav" class:list={[{ 'site-nav--hidden': hideNav }]} aria-label="Primary navigation">
      <a class:list={['site-nav__brand', { 'site-nav__brand--sticker': brandImage }]} href={base} aria-label="Melissa Keizer Photography home">
        <img src={`${base}${brandImage}`} alt="" />
      </a>
      <div class="site-nav__links">
        <a class:list={{ 'is-active': homeActive }} href={base} aria-current={homeActive ? 'page' : undefined}>Home</a>
        <a class:list={{ 'is-active': storiesActive }} href={`${base}posts/`} aria-current={storiesActive ? 'page' : undefined}>Stories</a>
        <a class:list={{ 'is-active': photoStreamActive }} href={`${base}photostream/`} aria-current={photoStreamActive ? 'page' : undefined}>PhotoStream</a>
      </div>
    </nav>
    {isDev && (
      <>
        <button class="debug-grid-toggle" type="button" aria-pressed="true" data-debug-grid-toggle>Hide grid</button>
        <div class="debug-grid" aria-hidden="true" data-debug-grid>
          {Array.from({ length: 12 }, (_, index) => <span>{index + 1}</span>)}
        </div>
      </>
    )}
    <slot />
    <SiteFooter />
    <script>
      import '../scripts/photo-loading';
    </script>
    <script>
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (document.documentElement.classList.contains('entrances-enabled')) {
        clearTimeout((window as Window & { entranceFallback?: number }).entranceFallback);
        const observer = new IntersectionObserver(entries => {
          let stagger = 0;
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            observer.unobserve(entry.target);
            const element = entry.target as HTMLElement;
            element.style.setProperty('--entrance-delay', `${Math.min(stagger++ * 70, 140)}ms`);
            element.classList.add('entrance-visible');
          }
        }, { threshold: 0, rootMargin: '0px 0px 24px 0px' });
        document.querySelectorAll(
          '.opening-copy > p, .opening-more, .opening-posts .project-card, .stories-grid--archive .project-card, .photostream-home-strip .field-note-card, .photostream-page .field-notes-entry, .field-notes-interlude, .site-footer__panel, .story-section__content, .story-section__photos, .story-section__split-photo'
        ).forEach(element => observer.observe(element));
        document.addEventListener('focusin', event => {
          const element = (event.target as HTMLElement).closest('.project-card, .site-footer__panel');
          if (element) { element.classList.add('entrance-visible'); observer.unobserve(element); }
        });
        const onMotionChange = (event: MediaQueryListEvent) => {
          if (!event.matches) return;
          observer.disconnect();
          document.documentElement.classList.remove('entrances-enabled');
        };
        if (motion.addEventListener) motion.addEventListener('change', onMotionChange);
        else motion.addListener(onMotionChange);
      }
    </script>
    {isDev && (
      <script is:inline>
        (() => {
          const button = document.querySelector('[data-debug-grid-toggle]');
          const grid = document.querySelector('[data-debug-grid]');
          if (!(button instanceof HTMLButtonElement) || !(grid instanceof HTMLElement)) return;

          const stored = localStorage.getItem('mk-debug-grid');
          let visible = stored !== 'hidden';
          const render = () => {
            grid.hidden = !visible;
            button.textContent = visible ? 'Hide grid' : 'Show grid';
            button.setAttribute('aria-pressed', String(visible));
          };

          button.addEventListener('click', () => {
            visible = !visible;
            localStorage.setItem('mk-debug-grid', visible ? 'visible' : 'hidden');
            render();
          });
          render();
        })();
      </script>
    )}
  </body>
</html>
