---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  theme?: 'light' | 'dark';
  hideNav?: boolean;
}

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');
const { title = 'Photography by Melissa Keizer', description = 'Freelance pet & event photographer based in Bangor, Northern Ireland.', image, theme = 'light', hideNav = false } = Astro.props;
const fullTitle = title === 'Photography by Melissa Keizer' ? title : `${title} — Melissa Keizer Photography`;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/jpeg" href={`${base}photos/sky-odin/000-ph_log7wlnpvdpmhx0i.jpg`} />
  </head>
  <body>
    <nav class="site-nav" class:list={[{ 'site-nav--hidden': hideNav }]} aria-label="Primary navigation">
      <a class="site-nav__brand" href={base} aria-label="Melissa Keizer Photography home">
        <img src={`${base}melissa-keizer-logo-icon.svg`} alt="" />
      </a>
    </nav>
    <slot />
    <footer class="site-footer">
      <div class="site-footer__cta">
        <p class="home-kicker">Work together</p>
        <h2>Have an animal, place or moment worth remembering?</h2>
        <p>I occasionally take on pet, animal and event photography projects across Northern Ireland.</p>
        <a class="site-footer__email" href="mailto:hi@melissakeizer.com">Get in touch <span aria-hidden="true">→</span></a>
      </div>
      <div class="site-footer__bottom">
        <p>&copy; {new Date().getFullYear()} Melissa Keizer.</p>
        <nav aria-label="Footer navigation">
          <a href={`${base}stories/`}>All posts</a>
          <a href={`${base}categories/`}>Categories</a>
          <a href="https://instagram.com/keizgoesboom" target="_blank" rel="noopener">Instagram</a>
          <a href="mailto:hi@melissakeizer.com">Email</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
