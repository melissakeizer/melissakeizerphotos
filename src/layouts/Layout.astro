---
import '../styles/global.css';
import '../styles/typography.css';
import '../styles/tablet.css';
import '../styles/entrances.css';
import '../styles/media-loading.css';
import '../styles/site-refinements.css';
import SiteFooter from '../components/SiteFooter.astro';
import Fonts from '../components/Fonts.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import { socialImage, homepagePreview } from '../lib/social-image.mjs';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  theme?: 'light' | 'dark';
  brandImage?: string;
  article?: boolean;
}

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');
const { title = 'Photography by Melissa Keizer', description: rawDescription = 'Personal photo stories, adventures and everyday moments by Melissa Keizer in Northern Ireland. More than a few dogs guaranteed.', image, theme = 'light', brandImage = 'melissa-keizer-sticker.png', article = false } = Astro.props;
const plainDescription = rawDescription.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
const description = plainDescription.length > 185 ? plainDescription.slice(0, 182).replace(/\s+\S*$/, '') + '…' : plainDescription;
const fullTitle = title === 'Photography by Melissa Keizer' ? title : `${title} — Melissa Keizer Photography`;
const pathname = Astro.url.pathname;
const homeActive = pathname.replace(/\/$/, '') === base.replace(/\/$/, '');
const palette = homeActive || pathname.includes('/photostream/') || pathname.includes('/previews/homepage/')
  ? 'warm-dark' : pathname.includes('/posts') ? 'warm-light' : undefined;
const isDev = import.meta.env.DEV;
const canonical = new URL(pathname.replace(base, '/'), Astro.site).href;
const preview = new URL(await socialImage(image ? image.replace(base, '/') : homepagePreview), Astro.site).href;
const privatePage = /^\/(previews|typefaces|content-board|photostream-arranger|field-notes-b)(\/|$)/.test(new URL(canonical).pathname);
const structuredData = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Person', '@id': `${Astro.site}#melissa`, name: 'Melissa Keizer', url: Astro.site.href, sameAs: ['https://www.instagram.com/KeizGoesBoom/', 'https://www.linkedin.com/in/melissakeizer/'] },
  { '@type': 'WebSite', '@id': `${Astro.site}#website`, url: Astro.site.href, name: 'MK Fotos', author: { '@id': `${Astro.site}#melissa` }, inLanguage: 'en-GB' },
  { '@type': article ? 'Article' : 'WebPage', '@id': `${canonical}#page`, url: canonical, name: fullTitle, ...(article ? { headline: title, author: { '@id': `${Astro.site}#melissa` }, mainEntityOfPage: canonical } : {}), description, image: preview, isPartOf: { '@id': `${Astro.site}#website` }, inLanguage: 'en-GB' },
  { '@type': 'ImageObject', contentUrl: preview, creator: { '@id': `${Astro.site}#melissa` }, creditText: 'Melissa Keizer', copyrightNotice: 'Melissa Keizer', width: 1200, height: 630 },
] };
---

<!doctype html>
<html lang="en-GB" data-theme={theme} data-palette={palette}>
  <head>
    <meta charset="UTF-8" />
    <Fonts />
    <script is:inline>
      if (window.CSS && CSS.supports('translate', '0')) document.documentElement.classList.add('camera-draw-enabled');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('video-autoplay-enabled');
        // If enhancement JS cannot load, photos remain a dependable fallback.
        window.cardVideoFallback = setTimeout(() => document.documentElement.classList.remove('video-autoplay-enabled'), 2000);
      }
    </script>
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window && window.CSS && CSS.supports('selector(:where(*))') && CSS.supports('translate', '0')) {
        document.documentElement.classList.add('entrances-enabled');
        // Fail open if the page script cannot load.
        window.entranceFallback = setTimeout(() => document.documentElement.classList.remove('entrances-enabled'), 4000);
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={privatePage ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="MK Fotos" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={preview} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={preview} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <Analytics />
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />}
    <title>{fullTitle}</title>
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href={`${base}favicon-32.png`} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} sizes="180x180" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteNavigation brandImage={brandImage} />
    {isDev && (
      <>
        <button class="debug-grid-toggle" type="button" aria-pressed="true" data-debug-grid-toggle>Hide grid</button>
        <div class="debug-grid" aria-hidden="true" data-debug-grid>
          {Array.from({ length: 12 }, (_, index) => <span>{index + 1}</span>)}
        </div>
      </>
    )}
    <div id="main-content" tabindex="-1"></div>
    <slot />
    <SiteFooter />
    <script>
      import '../scripts/photo-loading';
    </script>
    <script>
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (document.documentElement.classList.contains('entrances-enabled')) {
        clearTimeout((window as Window & { entranceFallback?: number }).entranceFallback);
        const observer = new IntersectionObserver(entries => {
          let stagger = 0;
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            observer.unobserve(entry.target);
            const element = entry.target as HTMLElement;
            element.style.setProperty('--entrance-delay', `${Math.min(stagger++ * 70, 140)}ms`);
            element.classList.add('entrance-visible');
          }
        }, { threshold: 0, rootMargin: '0px 0px 24px 0px' });
        document.querySelectorAll(
          '.opening-copy > p, .opening-more, .opening-posts .project-card, .stories-grid--archive .project-card, .photostream-home-strip .field-note-card, .photostream-page .field-notes-entry, .field-notes-interlude, .site-footer__panel, .story-section__content, .story-section__photos, .story-section__split-photo'
        ).forEach(element => observer.observe(element));
        document.addEventListener('focusin', event => {
          const element = (event.target as HTMLElement).closest('.project-card, .site-footer__panel');
          if (element) { element.classList.add('entrance-visible'); observer.unobserve(element); }
        });
        const onMotionChange = (event: MediaQueryListEvent) => {
          if (!event.matches) return;
          observer.disconnect();
          document.documentElement.classList.remove('entrances-enabled');
        };
        if (motion.addEventListener) motion.addEventListener('change', onMotionChange);
        else motion.addListener(onMotionChange);
      }
    </script>
    {isDev && (
      <script is:inline>
        (() => {
          const button = document.querySelector('[data-debug-grid-toggle]');
          const grid = document.querySelector('[data-debug-grid]');
          if (!(button instanceof HTMLButtonElement) || !(grid instanceof HTMLElement)) return;

          const stored = localStorage.getItem('mk-debug-grid');
          let visible = stored !== 'hidden';
          const render = () => {
            grid.hidden = !visible;
            button.textContent = visible ? 'Hide grid' : 'Show grid';
            button.setAttribute('aria-pressed', String(visible));
          };

          button.addEventListener('click', () => {
            visible = !visible;
            localStorage.setItem('mk-debug-grid', visible ? 'visible' : 'hidden');
            render();
          });
          render();
        })();
      </script>
    )}
  </body>
</html>

<style>
  .skip-link { position: fixed; top: .5rem; left: .5rem; z-index: 10000; padding: .75rem 1rem; background: #f5d51a; color: #1d1c1b; transform: translateY(-200%); }
  .skip-link:focus { transform: none; }
</style>
