---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  theme?: 'light' | 'dark';
  hideNav?: boolean;
  brandImage?: string;
}

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');
const { title = 'Photography by Melissa Keizer', description = 'Freelance pet & event photographer based in Bangor, Northern Ireland.', image, theme = 'light', hideNav = false, brandImage = 'melissa-keizer-sticker.png' } = Astro.props;
const fullTitle = title === 'Photography by Melissa Keizer' ? title : `${title} — Melissa Keizer Photography`;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/jpeg" href={`${base}photos/sky-odin/000-ph_log7wlnpvdpmhx0i.jpg`} />
  </head>
  <body>
    <nav class="site-nav" class:list={[{ 'site-nav--hidden': hideNav }]} aria-label="Primary navigation">
      <a class:list={['site-nav__brand', { 'site-nav__brand--sticker': brandImage }]} href={base} aria-label="Melissa Keizer Photography home">
        <img src={`${base}${brandImage}`} alt="" />
      </a>
    </nav>
    <slot />
    <footer class="site-footer" style={`--footer-photo: url('${base}photos/road-to-sligo/058-18ws24t1as3jk16geyp1vox1kmpqkdc7e28w.jpg')`}>
      <div class="site-footer__panel">
        <div class="site-footer__portrait">
          <img src={`${base}melissa-keizer-avatar.jpeg`} alt="Melissa Keizer" />
        </div>
        <div class="site-footer__introduction">
          <p class="home-kicker">A little about me</p>
          <h2>Hi, I’m Melissa Keizer.</h2>
          <p>I’m a photographer and designer in Northern Ireland, with a soft spot for animals, honest moments and taking the scenic route.</p>
        </div>
        <nav class="site-footer__links" aria-label="Explore">
          <p class="site-footer__label">Explore</p>
          <a href={base}>Home <span aria-hidden="true">↗</span></a>
          <a href={`${base}stories/`}>All posts <span aria-hidden="true">↗</span></a>
          <a href={`${base}field-notes/`}>PhotoStream <span aria-hidden="true">↗</span></a>
        </nav>
        <div class="site-footer__contact">
          <p class="site-footer__label">Elsewhere</p>
          <a href="https://instagram.com/keizgoesboom" target="_blank" rel="noopener">Instagram <span aria-hidden="true">↗</span></a>
          <a href="mailto:hi@melissakeizer.com">Email me <span aria-hidden="true">↗</span></a>
        </div>
        <div class="site-footer__colophon">
          <p class="site-footer__label">Colophon</p>
          <p>Photographed, written and designed by Melissa. Built as a permanent home for stories, galleries and passing observations.</p>
        </div>
        <div class="site-footer__bottom">
          <p>&copy; {new Date().getFullYear()} Melissa Keizer.</p>
          <p>Made in Bangor, Northern Ireland.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
