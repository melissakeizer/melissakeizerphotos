---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import sharp from 'sharp';
import nodePath from 'path';
import { categoriesForStory, coverStyleForStory, layoutForStorySection, subtitleForStory } from '../../lib/story-metadata';

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

interface Props {
  story: CollectionEntry<'stories'>;
}

interface Section {
  title: string | null;
  text: string;
  photos: string[];
  // Optional source-of-truth editorial override: spotlight, stacked, etc.
  layout?: string;
}

type Chunk =
  | { type: 'separator'; photo: string }
  | { type: 'article'; sections: Section[] };

const { story } = Astro.props;
const { data, body } = story;
const categories = categoriesForStory(story.id, data.categories);
const subtitle = subtitleForStory(story.id, data.subtitle);
const cover = data.coverImage || data.photos[0];
const isStory = data.type === 'story';
const coverStyle = coverStyleForStory(story.id, data.coverStyle ?? 'full');
const galleryLayout = data.galleryLayout ?? 'fitted-grid';

// Parse sections from markdown body for story type posts
let sections: Section[] = [];
if (isStory && body && body.trim()) {
  try {
    sections = JSON.parse(body.trim());
  } catch {
    sections = [];
  }
}

// Original Exposure layouts are specific to each editorial beat, not inferred
// solely from the number of photos. Prefer the recovered source layout.
sections = sections.map((section) => ({
  ...section,
  layout: layoutForStorySection(story.id, section.photos) ?? section.layout,
}));

// Read image aspect ratio at build time using sharp
async function getAspectRatio(photoPath: string): Promise<number> {
  try {
    const abs = nodePath.join(process.cwd(), 'public', photoPath.replace(/^\//, ''));
    const { width, height } = await sharp(abs).metadata();
    if (width && height) return width / height;
  } catch {}
  return 1.5; // fallback: landscape 3:2
}

// Precompute ratios for every multi-photo section so each justified row keeps
// the originals' proportions rather than using a masonry fallback.
const photoRatios = new Map<string, number>();
for (const section of sections) {
  const count = section.photos.length;
  if (count >= 2) {
    for (const photo of section.photos) {
      if (!photoRatios.has(photo)) {
        photoRatios.set(photo, await getAspectRatio(photo));
      }
    }
  }
}

// Split sections into article groups and full-bleed separators
const chunks: Chunk[] = [];
if (sections.length > 0) {
  let currentArticle: Section[] = [];
  for (const section of sections) {
    const isSep = !section.title && !section.text?.trim() && section.photos.length === 1 && (section.layout === 'full-bleed' || section.layout === 'parallax' || !section.layout);
    if (isSep) {
      if (currentArticle.length > 0) {
        chunks.push({ type: 'article', sections: currentArticle });
        currentArticle = [];
      }
      chunks.push({ type: 'separator', photo: section.photos[0] });
    } else {
      currentArticle.push(section);
    }
  }
  if (currentArticle.length > 0) {
    chunks.push({ type: 'article', sections: currentArticle });
  }
}

// Exposure galleries use the cover as the first photo in the fitted grid.
// Stories keep the cover separate because it is already rendered as the hero.
const galleryPhotos = !isStory
  ? [cover, ...data.photos].filter((photo): photo is string => Boolean(photo)).filter((photo, index, photos) => photos.indexOf(photo) === index)
  : [];

function photoUrl(path: string) {
  return `${base}${path.replace(/^\//, '')}`;
}

function photoLayoutClass(count: number) {
  if (count === 1) return 'single';
  if (count === 2) return 'pair';
  if (count === 3) return 'trio';
  if (count === 4) return 'quad';
  if (count === 5) return 'penta';
  return 'multi';
}
---

<Layout title={data.title} description={data.description || undefined} image={cover ? photoUrl(cover) : undefined} theme={data.theme ?? 'light'} hideNav={true}>
  <a class="story-home-btn" href={base} aria-label="Home">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><polyline points="9 21 9 12 15 12 15 21"/></svg>
  </a>
  {isStory && cover && coverStyle === 'full' && (
    <div class="story-hero-wrapper">
      <img
        class="story-hero"
        src={photoUrl(cover)}
        alt={data.title}
      />
      <div class="story-hero__overlay">
        <a class="story-hero__back" href={base}>← All Stories</a>
        <div class="story-hero__content">
          <h1 class="story-hero__title">{data.title}</h1>
          {subtitle && <p class="story-hero__subtitle">{subtitle}</p>}
          {(data.date || categories.length > 0) && (
            <div class="story-hero__meta">
              {data.date && <span>{data.date}</span>}
              {categories.map(cat => (
                <a href={`${base}categories/${cat.toLowerCase().replace(/\s+/g, '-')}`}>{cat}</a>
              ))}
            </div>
          )}
        </div>
        <div class="story-hero__author">
          <img
            class="story-hero__author-stamp"
            src={`${base}melissa-keizer-logo-icon.svg`}
            alt="Melissa Keizer Photography"
          />
          <span class="story-hero__author-label">By <strong>Melissa Keizer</strong></span>
        </div>
      </div>
    </div>
  )}

  {isStory && cover && coverStyle === 'split' && (
    <div class="story-hero-wrapper story-hero-wrapper--split">
      <div class="story-hero-split__photo">
        <img src={photoUrl(cover)} alt={data.title} />
      </div>
      <div class="story-hero-split__content">
        <a class="story-hero__back" href={base}>← All Stories</a>
        <div class="story-hero-split__body">
          <h1 class="story-hero-split__title">{data.title}</h1>
          {subtitle && <p class="story-hero-split__subtitle">{subtitle}</p>}
          {(data.date || categories.length > 0) && (
            <div class="story-hero__meta" style="justify-content: flex-start;">
              {data.date && <span>{data.date}</span>}
              {categories.map(cat => (
                <a href={`${base}categories/${cat.toLowerCase().replace(/\s+/g, '-')}`}>{cat}</a>
              ))}
            </div>
          )}
        </div>
        <div class="story-hero-split__author">
          <img
            class="story-hero-split__author-stamp"
            src={`${base}melissa-keizer-logo-icon.svg`}
            alt="Melissa Keizer Photography"
          />
          <span class="story-hero-split__author-label">By <strong>Melissa Keizer</strong></span>
        </div>
      </div>
    </div>
  )}

  {/* ── GALLERY LAYOUT ──────────────────────────────────────────────── */}
  {!isStory && (
    <div class="story-page">
      {
        <header class="story-header">
          <a class="story-header__back" href={base}>← All Stories</a>
          <h1 class="story-header__title">{data.title}</h1>
          {subtitle && <p class="story-header__subtitle">{subtitle}</p>}
          <div class="story-header__meta">
            {data.date && <span>{data.date}</span>}
            {categories.map(cat => (
              <a href={`${base}categories/${cat.toLowerCase().replace(/\s+/g, '-')}`}>{cat}</a>
            ))}
          </div>
          <hr class="story-divider" />
        </header>
      }
      {data.description && (
        <div class="story-intro">
          <p>{data.description}</p>
        </div>
      )}
      {galleryPhotos.length > 0 && (
        <div class:list={['masonry-gallery', `masonry-gallery--${galleryLayout}`]} id="gallery">
          {galleryPhotos.map((photo, i) => (
            <div
              class="masonry-gallery__item"
              data-index={i}
              data-src={photoUrl(photo)}
              role="button"
              tabindex="0"
              aria-label={`View photo ${i + 1}`}
            >
              <img
                src={photoUrl(photo)}
                alt={`${data.title} — photo ${i + 1}`}
                loading={i < 6 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
          ))}
        </div>
      )}
    </div>
  )}

  {/* ── STORY LAYOUT ────────────────────────────────────────────────── */}
  {isStory && chunks.length > 0 && chunks.map((chunk, chunkIndex) => (
    chunk.type === 'separator' ? (
      <div class="story-separator story-separator--parallax" style={`--parallax-image: url("${photoUrl(chunk.photo)}")`}>
        <img
          src={photoUrl(chunk.photo)}
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
    ) : (
      <div class:list={['story-page', { 'story-page--has-hero': cover && chunkIndex === 0 }]}>
        <article class="story-article">
          {chunk.sections.map((section) => {
            const isSpotlight = section.photos.length === 1 && section.layout === 'spotlight';
            const isFullBleed = section.photos.length === 1 && section.layout === 'full-bleed';
            const isEdgeToEdge = section.photos.length === 1 && section.layout === 'edge-to-edge';
            const isParallax = section.photos.length === 1 && section.layout === 'parallax';
            const isStacked = section.photos.length === 1 && (section.layout === 'stacked' || section.layout === 'stacked-centered');
            const isSplit = section.photos.length === 1 && !!section.text?.trim() && !isSpotlight && !isFullBleed && !isEdgeToEdge && !isParallax && !isStacked;
            return isSpotlight ? (
              <section class="story-section story-section--spotlight">
                {section.title && <h2 class="story-section__title">{section.title}</h2>}
                {section.text && <div class="story-section__text" set:html={section.text} />}
                <div class="story-section__photo-item story-section__photo-item--spotlight" data-src={photoUrl(section.photos[0])} role="button" tabindex="0" aria-label="View photo">
                  <img src={photoUrl(section.photos[0])} alt={section.title || data.title} loading="lazy" decoding="async" />
                </div>
              </section>
            ) : isStacked ? (
              <section class:list={['story-section', 'story-section--stacked', { 'story-section--stacked-centered': section.layout === 'stacked-centered' }]}>
                {section.title && <h2 class="story-section__title">{section.title}</h2>}
                {section.text && <div class="story-section__text" set:html={section.text} />}
                <div class="story-section__photo-item story-section__photo-item--stacked" data-src={photoUrl(section.photos[0])} role="button" tabindex="0" aria-label="View photo">
                  <img src={photoUrl(section.photos[0])} alt={section.title || data.title} loading="lazy" decoding="async" />
                </div>
              </section>
            ) : isFullBleed ? (
              <section class="story-section story-section--full-bleed">
                <div class="story-section__content">
                  {section.title && <h2 class="story-section__title">{section.title}</h2>}
                  {section.text && <div class="story-section__text" set:html={section.text} />}
                </div>
                <div class="story-section__full-bleed-photo" data-src={photoUrl(section.photos[0])} role="button" tabindex="0" aria-label="View photo">
                  <img src={photoUrl(section.photos[0])} alt={section.title || data.title} loading="lazy" decoding="async" />
                </div>
              </section>
            ) : isEdgeToEdge ? (
              <section class="story-section story-section--edge-to-edge">
                <div class="story-section__content">
                  {section.title && <h2 class="story-section__title">{section.title}</h2>}
                  {section.text && <div class="story-section__text" set:html={section.text} />}
                </div>
                <div class="story-section__edge-to-edge-photo" data-src={photoUrl(section.photos[0])} role="button" tabindex="0" aria-label="View photo">
                  <img src={photoUrl(section.photos[0])} alt={section.title || data.title} loading="lazy" decoding="async" />
                </div>
              </section>
            ) : isParallax ? (
              <section class="story-section story-section--parallax">
                <div class="story-section__content">
                  {section.title && <h2 class="story-section__title">{section.title}</h2>}
                  {section.text && <div class="story-section__text" set:html={section.text} />}
                </div>
                <div class="story-separator story-separator--parallax" style={`--parallax-image: url("${photoUrl(section.photos[0])}")`} data-src={photoUrl(section.photos[0])} role="button" tabindex="0" aria-label="View photo">
                  <img src={photoUrl(section.photos[0])} alt={section.title || data.title} loading="lazy" decoding="async" />
                </div>
              </section>
            ) : isSplit ? (
              <section class:list={['story-section', 'story-section--split', { 'story-section--split-reverse': section.layout === 'split-reverse' }]}>
                <div class="story-section__content">
                  {section.title && <h2 class="story-section__title">{section.title}</h2>}
                  <div class="story-section__text" set:html={section.text} />
                </div>
                <div class="story-section__split-photo" data-src={photoUrl(section.photos[0])} role="button" tabindex="0" aria-label="View photo">
                  <img src={photoUrl(section.photos[0])} alt={section.title || data.title} loading="lazy" decoding="async" />
                </div>
              </section>
            ) : (
              <section class="story-section">
                {section.title && (
                  <h2 class="story-section__title">{section.title}</h2>
                )}
                {section.text && (
                  <div class="story-section__text" set:html={section.text} />
                )}
                {section.photos && section.photos.length > 0 && (() => {
                  const layout = photoLayoutClass(section.photos.length);
                  const useFlexRatio = layout === 'pair' || layout === 'trio';

                  if (layout === 'multi') {
                    const rows = Array.from({ length: Math.ceil(section.photos.length / 3) }, (_, index) => section.photos.slice(index * 3, index * 3 + 3));
                    return (
                      <div class="story-section__photos story-section__photos--multi">
                        {rows.map((row) => (
                          <div class="multi-row">
                            {row.map((photo) => (
                              <div
                                class="story-section__photo-item"
                                data-src={photoUrl(photo)}
                                role="button"
                                tabindex="0"
                                aria-label="View photo"
                                style={`flex: ${photoRatios.get(photo) ?? 1.5} 1 0`}
                              >
                                <img src={photoUrl(photo)} alt={section.title || data.title} loading="lazy" decoding="async" />
                              </div>
                            ))}
                          </div>
                        ))}
                      </div>
                    );
                  }

                  if (layout === 'penta') {
                    const rows = [section.photos.slice(0, 3), section.photos.slice(3)];
                    return (
                      <div class="story-section__photos story-section__photos--penta">
                        {rows.map((row) => (
                          <div class="penta-row">
                            {row.map((photo) => (
                              <div
                                class="story-section__photo-item"
                                data-src={photoUrl(photo)}
                                role="button"
                                tabindex="0"
                                aria-label="View photo"
                                style={`flex: ${photoRatios.get(photo) ?? 1.5} 1 0`}
                              >
                                <img
                                  src={photoUrl(photo)}
                                  alt={section.title || data.title}
                                  loading="lazy"
                                  decoding="async"
                                />
                              </div>
                            ))}
                          </div>
                        ))}
                      </div>
                    );
                  }

                  if (layout === 'quad') {
                    const rows = [section.photos.slice(0, 2), section.photos.slice(2, 4)];
                    return (
                      <div class="story-section__photos story-section__photos--quad">
                        {rows.map((row) => (
                          <div class="quad-row">
                            {row.map((photo) => (
                              <div
                                class="story-section__photo-item"
                                data-src={photoUrl(photo)}
                                role="button"
                                tabindex="0"
                                aria-label="View photo"
                                style={`flex: ${photoRatios.get(photo) ?? 1.5} 1 0`}
                              >
                                <img src={photoUrl(photo)} alt={section.title || data.title} loading="lazy" decoding="async" />
                              </div>
                            ))}
                          </div>
                        ))}
                      </div>
                    );
                  }

                  return (
                    <div class={`story-section__photos story-section__photos--${layout}`}>
                      {section.photos.map((photo) => (
                        <div
                          class="story-section__photo-item"
                          data-src={photoUrl(photo)}
                          role="button"
                          tabindex="0"
                          aria-label="View photo"
                          style={useFlexRatio ? `flex: ${photoRatios.get(photo) ?? 1.5} 1 0` : undefined}
                        >
                          <img
                            src={photoUrl(photo)}
                            alt={section.title || data.title}
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                      ))}
                    </div>
                  );
                })()}
              </section>
            );
          })}
        </article>
        {data.footnotes && chunkIndex === chunks.length - 1 && (
          <aside class="story-footnotes">
            <h4 class="story-footnotes__title">Footnotes</h4>
            <p>{data.footnotes}</p>
          </aside>
        )}
      </div>
    )
  ))}

  {/* Fallback: story with no sections parsed */}
  {isStory && chunks.length === 0 && (
    <div class="story-page story-page--has-hero">
      {data.description && <div class="story-intro"><p>{data.description}</p></div>}
      {galleryPhotos.length > 0 && (
        <div class="masonry-gallery" id="gallery">
          {galleryPhotos.map((photo, i) => (
            <div class="masonry-gallery__item" data-index={i} data-src={photoUrl(photo)} role="button" tabindex="0" aria-label={`View photo ${i + 1}`}>
              <img src={photoUrl(photo)} alt={`${data.title} — photo ${i + 1}`} loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
      )}
    </div>
  )}

  <!-- Lightbox (shared by both layouts) -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button class="lightbox__close" id="lightbox-close" aria-label="Close">&times;</button>
    <button class="lightbox__prev" id="lightbox-prev" aria-label="Previous photo">&#8249;</button>
    <img class="lightbox__img" id="lightbox-img" src="" alt="" />
    <button class="lightbox__next" id="lightbox-next" aria-label="Next photo">&#8250;</button>
  </div>
</Layout>

<script>
  // Scroll-reveal animations
  document.body.classList.add('is-ready');
  requestAnimationFrame(() => document.body.classList.add('is-loaded'));
  const storySections = document.querySelectorAll('.story-section');
  if (storySections.length > 0) {
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    storySections.forEach(el => revealObserver.observe(el));
  }

  // Collect all clickable photo items regardless of layout
  const allItems = Array.from(
    document.querySelectorAll<HTMLElement>('.masonry-gallery__item, .story-section__photo-item')
  );

  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');

  if (!lightbox || !lightboxImg || allItems.length === 0) {
    // nothing to wire up
  } else {
    let current = 0;

    function openAt(index: number) {
      current = index;
      const src = allItems[current].dataset.src || '';
      lightboxImg.src = src;
      lightboxImg.alt = allItems[current].querySelector('img')?.alt || '';
      lightbox!.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox!.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    function prev() { openAt((current - 1 + allItems.length) % allItems.length); }
    function next() { openAt((current + 1) % allItems.length); }

    allItems.forEach((item, i) => {
      item.addEventListener('click', () => openAt(i));
      item.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') openAt(i); });
    });

    closeBtn?.addEventListener('click', close);
    prevBtn?.addEventListener('click', prev);
    nextBtn?.addEventListener('click', next);
    lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('is-open')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'ArrowRight') next();
    });
  }
</script>
