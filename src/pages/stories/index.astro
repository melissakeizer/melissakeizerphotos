---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categoriesForStory, subtitleForStory } from '../../lib/story-metadata';
import ProjectCard from '../../components/ProjectCard.astro';

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');
const stories = await getCollection('stories');
const sorted = stories.sort((a, b) => a.data.order - b.data.order);
const [featured, ...archiveStories] = sorted;
const categoryOrder = ['animals', 'pet sessions', 'adventures', 'live music'];
const featuredCover = featured?.data.coverImage || featured?.data.photos[0];
const featuredSubtitle = featured ? subtitleForStory(featured.id, featured.data.subtitle) : '';
---

<Layout title="All Posts">
  <header class="archive-header">
    <h1>All Posts</h1>
    <div class="archive-filters" aria-label="Filter posts">
      <button class="is-active" type="button" data-filter="all" aria-pressed="true">All</button>
      {categoryOrder.map((category) => <button type="button" data-filter={category} aria-pressed="false">{category}</button>)}
    </div>
  </header>
  <main>
    {featured && <article class="archive-feature" data-categories={categoriesForStory(featured.id, featured.data.categories).join('|')}>
      <div class="archive-feature__copy">
        <p class="home-kicker">Latest {featured.data.type}</p>
        <h2>{featured.data.title}</h2>
        {featuredSubtitle && <p>{featuredSubtitle}</p>}
        <a href={`${base}stories/${featured.id}`}>Read this post <span aria-hidden="true">→</span></a>
      </div>
      {featuredCover && <a class="archive-feature__image" href={`${base}stories/${featured.id}`} aria-label={`Read ${featured.data.title}`}>
        <img src={`${base}${featuredCover.replace(/^\//, '')}`} alt="" />
      </a>}
    </article>}
    <div class="stories-grid stories-grid--archive" id="stories">
      {archiveStories.map((story) => {
        const cover = story.data.coverImage || story.data.photos[0];
        const categories = categoriesForStory(story.id, story.data.categories);
        const subtitle = subtitleForStory(story.id, story.data.subtitle);
        return <ProjectCard
          href={`${base}stories/${story.id}`}
          image={cover ? `${base}${cover.replace(/^\//, '')}` : undefined}
          title={story.data.title}
          type={story.data.type}
          caption={subtitle}
          categories={categories}
        />;
      })}
    </div>
  </main>
</Layout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-categories]'));

  buttons.forEach((button) => button.addEventListener('click', () => {
    const filter = button.dataset.filter || 'all';
    buttons.forEach((item) => {
      const active = item === button;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-pressed', String(active));
    });
    cards.forEach((card) => {
      const categories = card.dataset.categories?.split('|') || [];
      card.hidden = filter !== 'all' && !categories.includes(filter);
    });
  }));
</script>
