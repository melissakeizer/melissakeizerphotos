---
import Layout from '../layouts/Layout.astro';
import { fieldNotes } from '../lib/field-notes';

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');

function photoUrl(path: string) {
  return `${base}${path.replace(/^\//, '')}`;
}

const landscapeNotes = new Set([
  'CD559E27-A3B6-4847-88F3-23600E312AA5_1_105_c.jpeg',
  '419ED7E6-DFC6-4CFD-B55B-94D4ABA16A06_1_105_c.jpeg',
  '7E90570A-F874-440A-BB64-F94C7D66A52B_1_102_o.jpeg',
]);
---

<Layout title="PhotoStream" description="A stream of single photographs, passing encounters and camera notes by Melissa Keizer." theme="dark">
  <main class="field-notes-page">
    <header class="field-notes-header">
      <h1>PhotoStream</h1>
      <p>For a girl who misses the simplicity of Flickr.</p>
    </header>

    <div class="field-notes-feed" data-field-notes-feed>
      {fieldNotes.map((note, index) => (
        <>
          {index === 4 && (
            <aside class="field-notes-interlude field-notes-interlude--qa" aria-labelledby="photostream-qa-title">
              <div class="field-notes-interlude__heading">
                <p class="home-kicker">A quick-fire Q&amp;A</p>
                <h2 id="photostream-qa-title">Behind the camera.</h2>
              </div>
              <div class="field-notes-interlude__item">
                <h3>Which lens do you reach for most?</h3>
                <p>My Sony 55mm f/1.8. It’s gorgeously sharp, gives me beautiful depth of field and I like the constraint of zooming with my feet.</p>
              </div>
              <div class="field-notes-interlude__item">
                <h3>What do you most enjoy photographing now?</h3>
                <p>Animals, always—but I’m also enjoying exploring automotive photography and finding a new visual language for it.</p>
              </div>
              <div class="field-notes-interlude__item">
                <h3>What got you into photography?</h3>
                <p>Wanting to hold onto the small details: live music, animals, journeys and the ordinary scenes that become meaningful later.</p>
              </div>
            </aside>
          )}
          <article class:list={['field-notes-entry', { 'field-notes-entry--landscape': landscapeNotes.has(note.image), 'is-deferred': index >= 15 }]}>
            <figure>
              <img src={photoUrl(`/photos/00-field-notes/${note.image}`)} alt={note.title} loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
            </figure>
            <div class="field-notes-entry__details">
              <div class="field-notes-entry__caption">
                <h2>{note.title}</h2>
                <p class="field-notes-entry__date"><span>{note.date}</span>{note.place && <span class="field-note-location"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.1 7-12A7 7 0 0 0 5 9c0 5.9 7 12 7 12Z"/><circle cx="12" cy="9" r="2.25"/></svg>{note.place}</span>}</p>
                {note.caption && <p class="field-notes-entry__note">{note.caption}</p>}
              </div>
              {(note.camera || note.lens || note.settings || note.metadataNote) && <div class="field-notes-entry__exif">
                {(note.camera || note.lens) && <p>{[note.camera, note.lens].filter(Boolean).join(' · ')}</p>}
                {note.metadataNote && !note.camera && !note.lens && <p>{note.metadataNote}</p>}
                {note.settings && <p>{note.settings}</p>}
              </div>}
            </div>
          </article>
        </>
      ))}
    </div>

    {fieldNotes.length > 15 && <button class="field-notes-load" type="button" data-load-more>Load more notes</button>}
  </main>
</Layout>

<script>
  const loadButton = document.querySelector<HTMLButtonElement>('[data-load-more]');
  loadButton?.addEventListener('click', () => {
    document.querySelectorAll<HTMLElement>('.field-notes-entry.is-deferred').forEach((entry, index) => {
      if (index < 15) entry.classList.remove('is-deferred');
    });
    if (!document.querySelector('.field-notes-entry.is-deferred')) loadButton.remove();
  });
</script>
