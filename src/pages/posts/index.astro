---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categoriesForStory, subtitleForStory, thumbnailForStory } from '../../lib/story-metadata';
import ProjectCard from '../../components/ProjectCard.astro';
import Heading from '../../components/Heading.astro';

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');
const stories = await getCollection('stories', ({ data }) => !data.draft);
const archiveOrder = new Map([
  ['vegas-baby', 6.5],
  ['dogs-of-dubrovnik', 8],
  ['pet-expo-belfast', 9],
  ['a-few-favourites', 10],
  ['dubrovnik-and-cavtat', 11],
  ['animals-afternoon-tea', 14],
  ['world-of-owls', 12],
  ['barks-and-bows', 15],
  ['cat-colony-of-cala-bona', 28],
  ['mutley-and-dexter', 30],
]);
const sorted = stories.sort((a, b) =>
  (archiveOrder.get(a.id) ?? a.data.order) - (archiveOrder.get(b.id) ?? b.data.order)
);
const categoryOrder = ['animals', 'pet sessions', 'adventures', 'live music'];
const categorySlug = (category: string) => category.toLowerCase().replace(/\s+/g, '-');
---

<Layout title="All Posts">
  <header class="archive-header">
    <Heading>All Posts</Heading>
    <div class="archive-filters" aria-label="Filter posts">
      <button class="is-active" type="button" data-filter="all" aria-pressed="true">All</button>
      {categoryOrder.map((category) => (
        <button type="button" data-filter={categorySlug(category)} aria-pressed="false"><span class="archive-filter-full">{category}</span><span class="archive-filter-mobile">{category === 'pet sessions' ? 'Pets' : category === 'live music' ? 'Music' : category}</span></button>
      ))}
    </div>
  </header>
  <main>
    <div class="stories-grid stories-grid--archive" id="posts">
      {sorted.map((story) => {
        const cover = thumbnailForStory(story.id, story.data.coverImage || story.data.photos[0]);
        const archiveCover = story.id === 'world-of-owls'
          ? '/photos/world-of-owls/011-ph_lqfa3al2vfqnk4ie.jpg'
          : story.id === 'cat-colony-of-cala-bona'
            ? '/videos/kitten-cala-bona-poster.jpg'
          : story.id === 'a-story-of-ice-and-fire'
            ? '/videos/storyboard-reflections-poster.jpg'
          : story.id === 'dubrovnik-and-cavtat'
            ? '/videos/dubrovnik-harbour-poster.jpg'
          : story.id === 'roaming-rome'
            ? '/videos/trevi-fountain-poster.jpg'
          : story.id === 'vegas-baby'
            ? '/videos/vegas-neon-poster.jpg'
          : cover;
        const archiveVideo = story.id === 'wild-ireland'
          ? 'videos/wolf-looking-toward-camera.mp4'
          : story.id === 'world-of-owls'
            ? 'videos/eagle-world-of-owls.mp4'
            : story.id === 'cat-colony-of-cala-bona'
              ? 'videos/kitten-cala-bona.mp4'
            : story.id === 'a-story-of-ice-and-fire'
              ? 'videos/storyboard-reflections.mp4'
            : story.id === 'dubrovnik-and-cavtat'
              ? 'videos/dubrovnik-harbour.mp4'
            : story.id === 'roaming-rome'
              ? 'videos/trevi-fountain.mp4'
            : story.id === 'vegas-baby'
              ? 'videos/vegas-neon.mp4'
            : undefined;
        const categories = categoriesForStory(story.id, story.data.categories);
        const subtitle = subtitleForStory(story.id, story.data.subtitle);
        return <ProjectCard
          href={`${base}stories/${story.id}`}
          image={archiveCover ? `${base}${archiveCover.replace(/^\//, '')}` : undefined}
          video={archiveVideo ? `${base}${archiveVideo}` : undefined}
          videoPosition={story.id === 'wild-ireland' ? 'center 20%' : undefined}
          title={story.data.title}
          type={story.data.type}
          caption={subtitle}
          categories={categories}
        />;
      })}
    </div>
  </main>
</Layout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-categories]'));
  const validFilters = new Set(buttons.map((button) => button.dataset.filter || 'all'));
  const slugify = (value: string) => value.toLowerCase().trim().replace(/\s+/g, '-');

  const filterFromUrl = () => {
    const requested = new URLSearchParams(window.location.search).get('category') || 'all';
    return validFilters.has(requested) ? requested : 'all';
  };

  const showFilter = (filter: string) => {
    buttons.forEach((button) => {
      const active = button.dataset.filter === filter;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });

    cards.forEach((card) => {
      const categories = (card.dataset.categories || '').split('|').map(slugify);
      card.hidden = filter !== 'all' && !categories.includes(filter);
    });
  };

  const updateUrl = (filter: string) => {
    const url = new URL(window.location.href);
    if (filter === 'all') url.searchParams.delete('category');
    else url.searchParams.set('category', filter);
    window.history.pushState({ filter }, '', url);
  };

  buttons.forEach((button) => button.addEventListener('click', () => {
    const filter = button.dataset.filter || 'all';
    showFilter(filter);
    updateUrl(filter);
  }));

  window.addEventListener('popstate', () => showFilter(filterFromUrl()));
  showFilter(filterFromUrl());
</script>
