---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { subtitleForStory } from '../lib/story-metadata';
import { fieldNotes } from '../lib/field-notes';

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');
const stories = await getCollection('stories');

// This is the curated homepage shelf: change the order or IDs here whenever
// a different set of work deserves prominence.
const selectedProjectIds = [
  'dubshed-northern-irelands-largest-car-show',
  'sky-odin',
  'finn-pointer-puppy',
  'vegas-baby',
  'road-to-sligo',
  'dogs-of-dubrovnik',
];
const selectedProjects = selectedProjectIds
  .map((id) => stories.find((story) => story.id === id))
  .filter((story): story is NonNullable<typeof story> => Boolean(story));

function photoUrl(path: string) {
  return `${base}${path.replace(/^\//, '')}`;
}
---

<Layout brandImage="melissa-keizer-sticker.png">
  <main class="home-page home-page--quiet">
    <section class="home-intro home-intro--compact" aria-labelledby="home-intro-title">
      <h1 id="home-intro-title">Animals, places and the moments between.</h1>
      <p class="home-intro__copy">I’m Melissa, a photographer in Northern Ireland. This is a home for considered stories, wandering galleries and the smaller encounters I want to remember.</p>
    </section>

    <section class="home-section home-section--projects" aria-label="Selected photography projects">
      <div class="home-project-grid home-project-grid--six">
        {selectedProjects.map((story) => {
          const cover = story.data.coverImage || story.data.photos[0];
          const subtitle = subtitleForStory(story.id, story.data.subtitle);
          return <article class="home-project-card">
            <a href={`${base}stories/${story.id}`}>
              <div class="home-project-card__image">
                {cover && <img src={photoUrl(cover)} alt={story.data.title} loading="lazy" decoding="async" />}
              </div>
              <h2>{story.data.title}</h2>
              <div class="home-project-card__meta">
                <p><strong>Type.</strong><span>{story.data.type}</span></p>
                {subtitle && <p><strong>Caption.</strong><span>{subtitle}</span></p>}
              </div>
            </a>
          </article>;
        })}
      </div>
      <div class="home-section__more">
        <a class="home-text-link" href={`${base}stories/`}>See all posts <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="home-field-notes home-field-notes--preview" id="field-notes" aria-labelledby="field-notes-title">
      <div class="home-field-notes__intro">
        <p class="home-kicker">Small moments, kept</p>
        <h2 id="field-notes-title">PhotoStream</h2>
        <p>One-off photographs, passing visitors and things seen along the way—with the camera details left intact.</p>
        <a class="home-text-link" href={`${base}field-notes/`}>Browse PhotoStream <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-field-notes__grid">
        {fieldNotes.slice(0, 6).map((fieldNote) => <figure class="field-note-card">
          <img src={photoUrl(`/photos/00-field-notes/${fieldNote.image}`)} alt={fieldNote.title} loading="lazy" decoding="async" />
          <figcaption>
            <strong>{fieldNote.title}</strong>
            <span>{fieldNote.camera ? `${fieldNote.camera}${fieldNote.lens ? ` · ${fieldNote.lens}` : ''}` : fieldNote.date}</span>
          </figcaption>
        </figure>)}
      </div>
    </section>
  </main>
</Layout>
