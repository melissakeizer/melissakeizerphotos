---
import { getCollection } from 'astro:content';
import { categoriesForStory } from '../../lib/story-metadata';

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  const categories = new Set(stories.flatMap((story) => categoriesForStory(story.id, story.data.categories)));
  return [...categories].map((category) => ({
    params: { category: category.toLowerCase().replace(/\s+/g, '-') },
  }));
}

const category = Astro.params.category || '';
return Astro.redirect(`${base}posts/?category=${encodeURIComponent(category)}`, 301);
---
