---
import { fieldNotes } from '../lib/field-notes';
import { allPhotoStreamQuestions } from '../lib/photo-stream-questions';
import photoStreamPlan from '../data/photo-stream-plan.json';
import { getPhotoStreamPages } from '../lib/photo-stream-pages';
import { responsivePhoto } from '../lib/responsive-photo';
import { photoShape } from '../lib/photo-shape.mjs';
import Fonts from '../components/Fonts.astro';
import '../styles/photostream-arranger.css';
import { listPhotoUploads, uploadPhotoForBrowser } from '../../scripts/photostream-upload-store.mjs';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Only private staging files are written by uploads, never public feed content.
if (!import.meta.env.DEV) return Astro.redirect(`${base}photostream/`);
const { pages, questionsByImage } = await getPhotoStreamPages();
const catalog = Object.fromEntries(await Promise.all(fieldNotes.map(async note => {
  const photo = await responsivePhoto(`${base}photos/00-photostream/${encodeURIComponent(note.image)}`);
  const src = photo.srcset.split(',')[0].trim().replace(/ \d+w$/, '');
  return [note.image, { image: note.image, title: note.title, date: note.date, shape: photoShape(photo.width, photo.height), src, sourceUploadId: note.sourceUploadId }];
})));
const testMode = Astro.url.searchParams.has('test');
const appliedUploads = new Set(fieldNotes.map(note => note.sourceUploadId).filter(Boolean));
for (const upload of await listPhotoUploads(process.cwd(), testMode)) {
  if (!appliedUploads.has(upload.image)) catalog[upload.image] = uploadPhotoForBrowser(upload, base, testMode);
}
const questionData = (qa: typeof allPhotoStreamQuestions[number]) => ({ id: qa.id, beforeImage: qa.beforeImage, label: qa.label, questions: qa.items.map(item => item.question) });
const source = { plan: photoStreamPlan, pages: pages.map(page => page.map(note => note.image)), questions: [...questionsByImage.values()].flat().map(questionData), questionCatalog: allPhotoStreamQuestions.map(questionData) };
const uploadEndpoint = `${base}__photostream-uploads/${testMode ? '?test=1' : ''}`;
const payload = JSON.stringify({ catalog, source, uploadEndpoint }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex, nofollow" /><title>Arrange PhotoStream · local planning board</title><Fonts /></head>
  <body>
    <header class="planner-header">
      <div class="planner-heading"><div><p class="planner-kicker">Local planning · not published</p><h1>Arrange PhotoStream</h1></div><a href={`${base}photostream/`} target="_blank" rel="noreferrer">View feed ↗</a></div>
      <div class="planner-toolbar">
        <button type="button" data-command="upload">↑ Upload photos</button>
        <button type="button" data-command="add-page">＋ Add page</button><button type="button" data-command="undo" disabled>Undo</button><button type="button" data-command="redo" disabled>Redo</button>
        <button type="button" class="planner-reset" data-command="reset">Reset to match live feed</button><button type="button" class="primary" data-command="export">Copy changes for Codex ↗</button><span role="status" aria-live="polite" data-status>Opening your plan…</span>
      </div><p class="planner-test" data-test-banner hidden>Test workspace — separate from your saved arrangement.</p>
    </header>
    <main class="planner-workspace">
      <aside class="planner-palette" aria-label="Row building blocks">
        <h2>Building blocks</h2><p>Drag into a page, or click to add to the selected page.</p>
        <button type="button" class="block-template" draggable="true" data-template="pair"><span class="template-pair" aria-hidden="true"><i></i><i></i></span>Portrait pair</button>
        <button type="button" class="block-template" draggable="true" data-template="landscape"><span class="template-landscape" aria-hidden="true"></span>Single landscape</button>
        <button type="button" class="block-template" draggable="true" data-template="qa"><span class="template-qa" aria-hidden="true">Q&amp;A</span>Questions &amp; notes</button>
        <div class="planner-help"><h3>Make it yours</h3><p>Drop on a photo to replace it. The old photo goes to Waiting.</p><p>Drop between rows to insert. Drag a row’s handle to move the whole row.</p><p>Prefer clicking? Pick a photo, then click a matching slot or a ＋ between rows.</p><p>Square photos fit either slot type: beside a portrait or on their own. Their crop stays unchanged.</p><p>Dates stay with photos. Removing one never deletes its file.</p></div>
        <p class="planner-safety">Drafts save in this browser. Your actual feed only changes after you paste the copied plan into Codex.</p>
      </aside>
      <section class="planner-canvas" aria-label="Feed pages"><div class="planner-selection" data-selection aria-live="polite"><span data-selection-text>Select a page, then build your layout.</span><button type="button" data-command="cancel-selection" hidden>Cancel pick</button></div><div class="planner-pages" data-pages></div></section>
      <aside class="planner-waiting" aria-label="Waiting area" data-drop="waiting">
        <h2>Waiting <span data-waiting-count></span></h2><p>Unused, removed or replaced. Drag back into any page.</p>
        <button type="button" class="upload-dropzone" data-command="upload">＋ Add photos from your computer<small>Choose files, or drop them here.<br />JPEG, PNG, WebP, TIFF, AVIF · up to 50 MB each</small></button>
        <p class="upload-status" role="status" aria-live="polite" data-upload-status></p>
        <label class="sr-only" for="waiting-search">Find a waiting photo</label><input type="search" id="waiting-search" placeholder="Find a photo or date…" data-search />
        <label class="sr-only" for="waiting-sort">Sort waiting photos</label><select id="waiting-sort" data-sort><option value="recent">Newest first</option><option value="oldest">Oldest first</option><option value="name">Photo name</option></select>
        <div class="waiting-photos" data-waiting></div><div class="waiting-qa" data-parked-qa></div>
      </aside>
    </main>
    <input type="file" multiple accept=".jpg,.jpeg,.png,.webp,.tif,.tiff,.avif,.heic,.heif" aria-label="Upload photos from your computer" data-file-input hidden />
    <dialog class="planner-dialog" data-insert-dialog><h2>Add a row here</h2><p>Choose a building block, then fill its photo slots.</p><div class="dialog-actions"><button type="button" data-insert-kind="pair">Portrait pair</button><button type="button" data-insert-kind="landscape">Single landscape</button><button type="button" data-insert-kind="qa">Q&amp;A block</button></div><button type="button" data-close-dialog>Cancel</button></dialog>
    <dialog class="planner-dialog" data-reset-dialog><h2>Reset to match live feed?</h2><p>This replaces this browser’s plan with the current local site layout, including its page breaks. It does not change the site or delete any photos. You can Undo afterwards.</p><div class="dialog-actions"><button type="button" data-close-dialog>Keep my plan</button><button type="button" class="primary" data-command="confirm-reset">Reset to match live feed</button></div></dialog>
    <dialog class="planner-dialog planner-export" data-export-dialog><h2>Your plan for Codex</h2><p>Copy and paste into our chat when you’re ready. This has not changed the feed.</p><p class="planner-warning" data-export-warning></p><textarea readonly aria-label="PhotoStream plan for Codex" data-copy-text></textarea><div class="dialog-actions"><button type="button" class="primary" data-command="copy-again">Copy text</button><button type="button" data-close-dialog>Close</button></div></dialog>
    <script is:inline type="application/json" id="planner-data" set:html={payload} />
    <script>import '../scripts/photostream-arranger';</script>
  </body>
</html>
