---
import Layout from '../layouts/Layout.astro';
import DisplayHeading from '../components/DisplayHeading.astro';

const styles = [
  { token: 'Display / H1', sample: 'I’m Melissa, this is my photo journal', className: 'type-system__display' },
  { token: 'H2 / Section', sample: 'PhotoStream', className: 'type-system__h2' },
  { token: 'H3 / Card', sample: 'A walk on the wild side', className: 'type-system__h3' },
  { token: 'H4 / Note', sample: 'Good genes', className: 'type-system__h4' },
];
---

<Layout title="Type system" description="The live Cambon and Fakt Pro type styles used across Melissa Keizer Photography.">
  <main class="type-system">
    <header class="type-system__intro">
      <p class="home-kicker">Design system · Type</p>
      <DisplayHeading>Type system</DisplayHeading>
      <p>This page uses the live styles from the site, so their names and proportions can be referenced directly when refining a page.</p>
    </header>

    <section class="type-system__section" aria-labelledby="headings-title">
      <div class="type-system__section-heading">
        <h2 id="headings-title">Headings</h2>
        <p>Cambon · editorial voice</p>
      </div>
      <div class="type-system__samples">
        {styles.map((style) => (
          <article class="type-system__sample">
            <p class="type-system__label">{style.token}</p>
            <p class={style.className}>{style.sample}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="type-system__section" aria-labelledby="body-title">
      <div class="type-system__section-heading">
        <h2 id="body-title">Reading text</h2>
        <p>Cambon · stories</p>
      </div>
      <div>
        <article class="type-system__sample">
          <p class="type-system__label">Story body</p>
          <p class="type-system__story-body">A little later, the path opened onto the shore. The dogs ran ahead, the light slipped through the trees, and for a moment the whole afternoon felt worth remembering.</p>
        </article>
        <article class="type-system__sample">
          <p class="type-system__label">Editorial introduction</p>
          <p class="type-system__intro-copy">A home for little adventures, wet noses, beautiful places and moments worth remembering—from Northern Ireland and beyond.</p>
        </article>
      </div>
    </section>

    <section class="type-system__section" aria-labelledby="utility-title">
      <div class="type-system__section-heading">
        <h2 id="utility-title">Utility text</h2>
        <p>Fakt Pro · details and navigation</p>
      </div>
      <div class="type-system__utility-grid">
        <article class="type-system__sample">
          <p class="type-system__label">Body / UI copy</p>
          <p class="type-system__ui-body">One-off photographs, passing visitors and things seen along the way.</p>
        </article>
        <article class="type-system__sample">
          <p class="type-system__label">Metadata</p>
          <p class="type-system__metadata">Sony A7 IV · 55mm · County Down</p>
        </article>
        <article class="type-system__sample">
          <p class="type-system__label">Navigation</p>
          <p class="type-system__navigation">Stories&nbsp;&nbsp;&nbsp; PhotoStream&nbsp;&nbsp;&nbsp; Contact</p>
        </article>
        <article class="type-system__sample">
          <p class="type-system__label">Byline</p>
          <p class="type-system__byline"><span>By</span> MELISSA KEIZER</p>
        </article>
      </div>
    </section>
  </main>
</Layout>

<style>
  .type-system { max-width: var(--grid-max); margin: 0 auto; padding: clamp(8rem, 12vw, 12rem) var(--site-margin) 8rem; }
  .type-system__intro { max-width: 58rem; margin-bottom: clamp(5rem, 8vw, 8rem); }
  .type-system__intro :global(.display-heading) { margin-top: 1.25rem; }
  .type-system__intro > p:last-child { max-width: 42rem; margin-top: 1.5rem; color: var(--color-muted); font-family: var(--font-sans); line-height: 1.6; }
  .type-system__section { display: grid; grid-template-columns: minmax(11rem, 2fr) 8fr; gap: var(--grid-gap); padding: clamp(3rem, 5vw, 5rem) 0; border-top: 1px solid var(--color-border); }
  .type-system__section-heading h2 { font: 600 0.75rem/1.2 var(--font-sans); letter-spacing: 0.12em; text-transform: uppercase; }
  .type-system__section-heading p { margin-top: 0.45rem; color: var(--color-muted); font: 0.75rem/1.4 var(--font-sans); }
  .type-system__samples, .type-system__utility-grid { display: grid; gap: 0; }
  .type-system__utility-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--grid-gap); }
  .type-system__sample { min-width: 0; padding: 0 0 2.5rem; }
  .type-system__sample + .type-system__sample { padding-top: 2.5rem; border-top: 1px solid var(--color-border); }
  .type-system__utility-grid .type-system__sample:nth-child(2) { padding-top: 0; border-top: 0; }
  .type-system__label { margin-bottom: 1.1rem; color: var(--color-muted); font: 600 0.62rem/1.2 var(--font-sans); letter-spacing: 0.11em; text-transform: uppercase; }
  .type-system__display { max-width: 14ch; font: 500 clamp(2.75rem, 5vw, 5rem)/0.96 var(--font-serif); letter-spacing: -0.045em; }
  .type-system__h2 { font: 600 clamp(2.25rem, 4vw, 4rem)/1 var(--font-serif); letter-spacing: -0.04em; }
  .type-system__h3 { font: 500 clamp(1.65rem, 2.55vw, 2.9rem)/1 var(--font-serif); letter-spacing: -0.035em; }
  .type-system__h4 { font: 400 1.05rem/1.15 var(--font-serif); }
  .type-system__story-body { max-width: 38rem; font: clamp(1.08rem, 1.18vw, 1.28rem)/1.7 var(--font-serif); }
  .type-system__intro-copy { max-width: 36rem; color: var(--color-muted); font: 1.05rem/1.55 var(--font-serif); }
  .type-system__ui-body { max-width: 30rem; font: 1rem/1.6 var(--font-sans); }
  .type-system__metadata, .type-system__navigation { font: 600 0.68rem/1.4 var(--font-sans); letter-spacing: 0.11em; text-transform: uppercase; }
  .type-system__byline { font: 600 0.68rem/1.4 var(--font-sans); letter-spacing: 0.11em; }
  .type-system__byline span { margin-right: 0.35rem; font: 400 0.88rem/1 var(--font-serif); letter-spacing: 0; text-transform: none; }
  @media (max-width: 700px) {
    .type-system { padding-right: 1rem; padding-left: 1rem; }
    .type-system__section { display: block; }
    .type-system__section-heading { margin-bottom: 2.5rem; }
    .type-system__utility-grid { grid-template-columns: 1fr; }
    .type-system__utility-grid .type-system__sample:nth-child(2) { padding-top: 2.5rem; border-top: 1px solid var(--color-border); }
  }
</style>
