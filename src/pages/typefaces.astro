---
import Layout from '../layouts/Layout.astro';
import Heading from '../components/Heading.astro';
const headings = [
 { level: 'h1' as const, name: 'H1', use: 'Homepage, All Posts and PhotoStream page titles', sample: 'My photo journal', size: '54px', weight: '400' },
 { level: 'h2' as const, name: 'H2', use: 'Section headings: PhotoStream, More like this, story chapters', sample: 'More like this', size: '42px', weight: '400' },
 { level: 'h3' as const, name: 'H3', use: 'Post-card titles and PhotoStream photo titles', sample: 'Walk on the Wild Side', size: '30px', weight: '400' },
 { level: 'h4' as const, name: 'H4', use: 'Small photo titles in the homepage PhotoStream strip', sample: 'She’s My Religion', size: '20px', weight: '400' },
];
const paragraphs = [
 { name: 'Paragraph', use: 'Cambon · homepage introduction and PhotoStream strip introduction', className: 'type-paragraph', sample: 'A home for little adventures, wet noses, beautiful places and moments worth remembering — from Northern Ireland and beyond.' },
 { name: 'Small paragraph', use: 'Fakt Pro · PhotoStream descriptions and Q&A answers', className: 'type-paragraph--small', sample: 'Heather Baron-Gracie of Pale Waves, performing at The Limelight, Belfast.' },
 { name: 'Story paragraph', use: 'Cambon · larger text for reading a story', className: 'type-paragraph--story', sample: 'A little later, the path opened onto the shore. The dogs ran ahead, the light slipped through the trees, and for a moment the whole afternoon felt worth remembering.' },
 { name: 'Caption', use: 'Cambon · subtitle beneath a post-card title', className: 'type-caption', sample: 'Wild Ireland, County Donegal' },
 { name: 'Detail', use: 'Fakt Pro · location, EXIF and camera details', className: 'type-detail', sample: 'The Limelight, Belfast · Sony A7 IV · 55mm' },
];
---
<Layout title="Typography reference">
 <main class="type-reference">
  <header class="type-reference__intro">
   <Heading>Typography reference</Heading>
   <p class="type-paragraph--small">One shared scale for the current site. Desktop reference sizes are shown below; the live measurements change with your browser width. Page and card headings use regular weight; story and gallery detail titles share a heavier hero variant.</p>
  </header>
  <section aria-label="Headings">
   {headings.map(style => <article class="type-sample">
    <header><h2>{style.name} · {style.size} · weight {style.weight}</h2><p>{style.use}</p><p data-type-measurement /></header>
    <div class="type-sample__preview"><Heading as={style.level}>{style.sample}</Heading></div>
   </article>)}
  </section>
  <section aria-label="Paragraphs and details">
   {paragraphs.map(style => <article class="type-sample">
    <header><h2>{style.name}</h2><p>{style.use}</p><p data-type-measurement /></header>
    <div class="type-sample__preview"><p class={style.className}>{style.sample}</p></div>
   </article>)}
  </section>
  <section aria-label="Story-specific variants">
   <article class="type-sample">
    <header><h2>Story / gallery title · 72px · weight 600</h2><p>Same H1 style for image heroes, split heroes and gallery detail pages.</p><p data-type-measurement /></header>
    <div class="type-sample__preview"><Heading size="story-hero">Young Finn the GSP</Heading></div>
   </article>
   <article class="type-sample">
    <header><h2>Story subtitle · H3 style</h2><p>Uses the same size, weight and upright style as H3; remains a paragraph beneath the title.</p><p data-type-measurement /></header>
    <div class="type-sample__preview"><p class="type-heading type-heading--h3 type-story-subtitle">Wild Ireland, County Donegal</p></div>
   </article>
  </section>
 </main>
</Layout>
<script>
 function measureType() {
  document.querySelectorAll('.type-sample').forEach(sample => {
   const element = sample.querySelector('.type-sample__preview')?.firstElementChild;
   const label = sample.querySelector('[data-type-measurement]');
   if (!element || !label) return;
   const style = getComputedStyle(element);
   const lineHeight = style.lineHeight === 'normal' ? 'normal' : parseFloat(style.lineHeight).toFixed(1) + 'px';
   label.textContent = style.fontFamily.split(',')[0].replaceAll('"','') + ' · ' + parseFloat(style.fontSize).toFixed(1) + 'px · line height ' + lineHeight + ' · weight ' + style.fontWeight;
  });
 }
 document.fonts.ready.then(measureType);
 window.addEventListener('resize', measureType);
</script>
<style>
 .type-reference { padding: 170px var(--site-margin) 80px; }
 .type-reference__intro { max-width: 760px; margin-bottom: 64px; }
 .type-reference__intro p { margin-top: 24px; color: var(--color-muted); }
 .type-sample { display: grid; grid-template-columns: minmax(200px,1fr) minmax(0,3fr); gap: 32px; padding: 36px 0; border-top: 1px solid var(--color-border); }
 .type-sample > header h2 { font: 500 14px/1.5 var(--font-sans); }
 .type-sample > header p { margin-top: 8px; font: 12px/1.5 var(--font-sans); color: var(--color-muted); }
 .type-sample__preview { min-width: 0; }
 .type-sample__preview p { max-width: 44rem; }
 @media(max-width:700px) {
  .type-reference { padding-top: 140px; }
  .type-sample { grid-template-columns: 1fr; gap: 20px; }
 }
</style>
