---
import Layout from '../layouts/Layout.astro';

const pairings = [
  { name: 'Cambon + Fakt Pro', note: 'The pairing from melissakeizer.com', heading: 'Cambon', body: 'Fakt Pro' },
  { name: 'Newsreader + Inter', note: 'Literary, calm and exceptionally readable', heading: 'Newsreader', body: 'Inter' },
  { name: 'Source Serif 4 + Source Sans 3', note: 'Editorial without feeling nostalgic', heading: 'Source Serif 4', body: 'Source Sans 3' },
  { name: 'Fraunces + Manrope', note: 'Warm, characterful and a little playful', heading: 'Fraunces', body: 'Manrope' },
  { name: 'Instrument Serif + Inter', note: 'Expressive display type with a quiet utility face', heading: 'Instrument Serif', body: 'Inter' },
  { name: 'Libre Caslon Display + Work Sans', note: 'Classic magazine energy with a contemporary body', heading: 'Libre Caslon Display', body: 'Work Sans' },
  { name: 'Lora + IBM Plex Sans', note: 'Friendly, grounded and highly legible', heading: 'Lora', body: 'IBM Plex Sans' },
  { name: 'Cormorant Garamond + DM Sans', note: 'Elegant and photographic, with stronger contrast', heading: 'Cormorant Garamond', body: 'DM Sans' },
  { name: 'Playfair Display + Source Sans 3', note: 'A familiar editorial pairing with plenty of clarity', heading: 'Playfair Display', body: 'Source Sans 3' },
  { name: 'Bodoni Moda + Manrope', note: 'High-fashion contrast, softened by a geometric sans', heading: 'Bodoni Moda', body: 'Manrope' },
  { name: 'Noto Serif Display + Noto Sans', note: 'A broad, dependable family with subtle personality', heading: 'Noto Serif Display', body: 'Noto Sans' },
  { name: 'Literata + Public Sans', note: 'Bookish and humane, but still clean on screen', heading: 'Literata', body: 'Public Sans' },
];
---

<Layout title="Typeface studies" description="Twelve typeface pairings considered for Melissa Keizer Photography.">
  <main class="type-studies">
    <header class="type-studies__intro">
      <p class="home-kicker">Design study · 01</p>
      <h1>Typeface pairings</h1>
      <p>The same small photography story set twelve ways. Nothing here changes the live site—it is a place to compare voice, rhythm and readability before choosing a system.</p>
    </header>

    <div class="type-studies__list">
      {pairings.map((pairing, index) => <article class="type-specimen" style={`--spec-heading: '${pairing.heading}'; --spec-body: '${pairing.body}'`}>
        <aside>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{pairing.name}</strong>
          <small>{pairing.note}</small>
        </aside>
        <div class="type-specimen__sample">
          <p class="type-specimen__eyebrow">A photographic journal</p>
          <h2>Things worth stopping for</h2>
          <h3>Wild places, familiar faces and the scenic route</h3>
          <p>I’m Melissa, a photographer in Northern Ireland. This is a home for considered stories, wandering galleries and the smaller encounters I want to remember.</p>
          <p class="type-specimen__meta">Sony A7 IV · 55mm · County Down</p>
        </div>
      </article>)}
    </div>
  </main>
</Layout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,600&family=Cormorant+Garamond:wght@400;600&family=DM+Sans:wght@400;600&family=Fraunces:opsz,wght@9..144,400;9..144,600&family=IBM+Plex+Sans:wght@400;600&family=Instrument+Serif&family=Inter:wght@400;600&family=Libre+Caslon+Display&family=Literata:opsz,wght@7..72,400;7..72,600&family=Lora:wght@400;600&family=Manrope:wght@400;600&family=Newsreader:opsz,wght@6..72,400;6..72,600&family=Noto+Sans:wght@400;600&family=Noto+Serif+Display:wght@400;600&family=Playfair+Display:wght@400;600&family=Public+Sans:wght@400;600&family=Source+Sans+3:wght@400;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Work+Sans:wght@400;600&display=swap');
</style>
