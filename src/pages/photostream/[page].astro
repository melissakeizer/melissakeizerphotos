---
import PhotoStreamView from '../../components/PhotoStreamView.astro';
import { getPhotoStreamPages } from '../../lib/photo-stream-pages';

export async function getStaticPaths() {
  const { pages } = await getPhotoStreamPages();
  const totalPages = pages.length;
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}
---
<PhotoStreamView currentPage={Number(Astro.params.page)} />
