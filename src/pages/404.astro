---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Page Not Found" description="This page has wandered off. Find your way back to Melissa Keizer’s photo journal.">
  <main class="contact-page not-found-page">
    <h1>Well, this is a dead end.</h1>
    <p>This page may have moved, or the link might be a little out of date.</p>
    <p><Button href={base}>Back Home</Button></p>
  </main>
</Layout>

<style>
  .not-found-page {
    box-sizing: border-box;
    min-height: 75vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-top: calc(var(--site-nav-clearance) + clamp(3rem, 8vh, 7rem));
    padding-bottom: clamp(6rem, 15vh, 12rem);
  }
  .not-found-page > p:last-child { margin-top: 1.5rem; }
</style>
