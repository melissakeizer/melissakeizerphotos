---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Page Not Found" description="This page has wandered off. Find your way back to Melissa Keizer’s photo journal.">
  <main class="contact-page">
    <h1>Well, this is a dead end.</h1>
    <p>This page may have moved, or the link might be a little out of date.</p>
    <p><Button href={base}>Back Home</Button></p>
    <p><a href={`${base}posts/`}>Explore the stories</a> or <a href={`${base}photostream/`}>browse PhotoStream</a>.</p>
  </main>
</Layout>
