---
import Photo from './Photo.astro';
import Layout from '../layouts/Layout.astro';
import DisplayHeading from './DisplayHeading.astro';
import Heading from './Heading.astro';
import CameraDrawing from './CameraDrawing.astro';
import PhotoStreamPagination from './PhotoStreamPagination.astro';
import { getPhotoStreamPages } from '../lib/photo-stream-pages';
import { photoStreamAnchor } from '../lib/photo-stream-links';

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');
interface Props { currentPage?: number; }
const { currentPage = 1 } = Astro.props;
const { pages, landscapeImages: landscapeNotes, dimensions, questionsByImage: questions, rowsByImage } = await getPhotoStreamPages();
const totalPages = pages.length;
const pageNotes = pages[currentPage - 1];

function photoUrl(path: string) {
  return `${base}${path.replace(/^\//, '')}`;
}

---

<Layout title={currentPage === 1 ? 'PhotoStream' : `PhotoStream — Page ${currentPage}`} description="A stream of single photographs, passing encounters and camera notes by Melissa Keizer." theme="dark">
  <main class="field-notes-page photostream-page">
    <header class="field-notes-header">
      <div class="photostream-intro-copy">
        {/* PhotoStream eyebrow hidden while reviewing the simpler title treatment. */}
        <DisplayHeading>For the girl<br />who misses Flickr.</DisplayHeading>
        <p class="photostream-intro-description">A photo journal of some shots I'm proud of, some everyday moments, and more than a few dogs.</p>
      </div>
      <div class="photostream-phone" aria-hidden="true">
        <CameraDrawing variant="phone-full" id="photostream-phone-pencil" />
      </div>
    </header>

    <div class="field-notes-feed" data-field-notes-feed>
      {pageNotes.map((note, index) => (
        <>
          {(questions.get(note.image) ?? []).map(block => (
            <aside class:list={['field-notes-interlude', 'field-notes-interlude--qa', { 'field-notes-interlude--two-column': block.layout === 'two-column', 'field-notes-interlude--staggered': block.layout === 'staggered' }]} aria-label="Quick-fire Q&A" data-qa-id={block.id}>
              <div class="field-notes-interlude__heading">
                <p class="home-kicker">{block.layout === 'two-column' ? 'Quick-fire Q&A' : <>Quick-fire<br class="qa-desktop-break" /> Q&amp;A</>}</p>
                <p class="field-notes-interlude__topic">{block.label}</p>
              </div>
              {block.items.map(item => <div class="field-notes-interlude__item"><h3>{item.question}</h3><p>{item.answer}</p></div>)}
            </aside>
          ))}
          <article id={photoStreamAnchor(note.image)} data-feed-row={rowsByImage.get(note.image)} class:list={['field-notes-entry', { 'field-notes-entry--landscape': landscapeNotes.has(note.image) }]}>
            <figure>
              <Photo src={photoUrl(`/photos/00-photostream/${note.image}`)} alt={note.title} sizes={landscapeNotes.has(note.image) ? '(max-width: 900px) 94vw, 62vw' : '(max-width: 600px) 94vw, (max-width: 900px) 46vw, 30vw'} width={dimensions.get(note.image)?.width} height={dimensions.get(note.image)?.height} loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
            </figure>
            <div class="field-notes-entry__details">
              <div class="field-notes-entry__caption">
                <Heading as="h3">{note.title}</Heading>
                {note.memorialDates && <p class="field-notes-entry__date">{note.memorialDates}</p>}
                {note.place && <p class="field-notes-entry__date"><span class="field-note-location"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.1 7-12A7 7 0 0 0 5 9c0 5.9 7 12 7 12Z"/><circle cx="12" cy="9" r="2.25"/></svg>{note.place}</span></p>}
                {note.caption && <p class="field-notes-entry__note">{note.caption}</p>}
              </div>
              {(note.camera || note.lens || note.settings || note.metadataNote) && <div class="field-notes-entry__exif">
                {(note.camera || note.lens) && <p>{[note.camera, note.lens].filter(Boolean).join(' · ')}</p>}
                {note.metadataNote && !note.camera && !note.lens && <p>{note.metadataNote}</p>}
                {note.settings && <p>{note.settings}</p>}
              </div>}
            </div>
          </article>
        </>
      ))}
    </div>

    <PhotoStreamPagination currentPage={currentPage} totalPages={totalPages} />
  </main>
  {import.meta.env.DEV && <div class="story-editor"><a class="story-editor__toggle" href={`${base}photostream-arranger/`}>Arrange this feed ↗</a></div>}
</Layout>

<style>
  /* Captions size to their content in the feed; the old side-by-side layout
     reserved 20rem here at intermediate widths. */
  .photostream-page .field-notes-entry__details { min-height: 0; }
  .photostream-page .field-notes-interlude--qa { row-gap: 1.25rem; padding: clamp(1.5rem, 3vw, 3rem) 0; }
  .photostream-page .field-notes-interlude--qa .field-notes-interlude__item p { margin-top: .65rem; text-wrap: pretty; }
  .photostream-page .field-notes-interlude--two-column { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .photostream-page .field-notes-interlude--two-column .field-notes-interlude__heading { grid-column: 1 / -1; }
  .photostream-page .field-notes-interlude--two-column .field-notes-interlude__item { grid-column: auto; }
  .photostream-page .field-notes-interlude--two-column .field-notes-interlude__item :is(h3, p) { max-width: none; }
  .photostream-page .field-notes-interlude--two-column .field-notes-interlude__heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .photostream-page .field-notes-interlude--two-column .field-notes-interlude__topic { margin-top: 0; }
  .photostream-page .field-notes-interlude--staggered { grid-template-columns: repeat(8, minmax(0, 1fr)); row-gap: 2.5rem; }
  .photostream-page .field-notes-interlude--staggered .field-notes-interlude__heading { grid-column: 1 / span 2; grid-row: 1; }
  .photostream-page .field-notes-interlude--staggered .field-notes-interlude__item { grid-column: 3 / span 3; }
  .photostream-page .field-notes-interlude--staggered .field-notes-interlude__item:nth-child(3) { grid-column: 6 / span 3; }
  .photostream-page .field-notes-interlude--staggered .field-notes-interlude__item :is(h3, p) { max-width: none; }
  @media (max-width: 700px) { .photostream-page .field-notes-interlude--two-column { grid-template-columns: 1fr; } }
  .photostream-page .field-notes-interlude__heading .home-kicker {
    font-size: clamp(1.1rem, 1.8vw, 1.7rem);
    font-weight: 650;
    line-height: 1.12;
    letter-spacing: -.025em;
  }
  .field-notes-interlude__topic {
    margin-top: .8rem;
    color: var(--color-muted);
    font: 500 .68rem/1.4 var(--font-sans);
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .photostream-page { --photostream-inset: max(var(--site-gutter), calc((100vw - var(--site-canvas)) / 2 + var(--site-gutter))); }
  .photostream-page .field-notes-header {
    top: 16rem;
    height: calc(100svh - 16rem);
    padding: 2rem 1.5rem 0 0;
    /* Let the complete phone scroll into view as this sticky column releases. */
    clip-path: inset(0 -1rem -8rem -100vw);
  }
  .photostream-intro-copy { position: relative; z-index: 1; }
  .photostream-intro-description {
    max-width: 30ch;
    margin: 1rem 0 0;
    font: 400 var(--type-paragraph)/1.45 var(--font-serif);
    color: var(--color-dark-muted);
  }
  @media (max-width: 1180px) {
    :root .photostream-page.photostream-page.photostream-page .field-notes-header {
      height: auto;
      min-height: 10rem;
    }
  }
  .photostream-eyebrow {
    margin: 0 0 1.1rem;
    font: 500 .68rem/1.4 var(--font-sans);
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--color-yellow);
  }
  .photostream-page .field-notes-header em { font-weight: 400; }
  .photostream-phone {
    position: absolute;
    left: calc(-1 * var(--photostream-inset) - 1rem - 20px);
    bottom: -4rem;
    width: clamp(15.4rem, calc((100svh - 22rem) * .55), 24.2rem);
    opacity: .48;
    filter: brightness(1.8);
    pointer-events: none;
  }
  @media (max-width: 1100px) {
    .photostream-page .field-notes-header {
      position: relative;
      top: auto;
      height: 23rem;
      margin-bottom: 2rem;
      padding-top: 0;
      clip-path: inset(0 -1rem 0 -100vw);
    }
    .photostream-intro-copy { padding-left: 35%; }
    .photostream-phone { width: 14.3rem; bottom: -6rem; }
  }
  @media (max-width: 700px) {
    .photostream-page { overflow-x: clip; }
    .photostream-page .field-notes-header { height: 10rem; padding-right: 0; margin-bottom: 1.5rem; clip-path: none; }
    .photostream-intro-copy { padding-left: 12%; }
    .photostream-eyebrow { margin-bottom: .8rem; font-size: .62rem; }
    .photostream-phone { top: 105px; bottom: auto; left: auto; right: -46px; width: 150px; opacity: .36; }
    .photostream-page .field-notes-feed { position: relative; z-index: 1; }
    .photostream-page .field-notes-interlude--qa { padding: 2rem 0 3rem; row-gap: 1.5rem; }
    .photostream-page .field-notes-interlude__heading .home-kicker { white-space: nowrap; font-size: 1.05rem; }
    .photostream-page .field-notes-interlude__heading .qa-desktop-break { display: none; }
    .photostream-page .field-notes-interlude--qa .field-notes-interlude__item :is(h3, p) { max-width: none; }
    .photostream-page .field-notes-interlude--staggered { grid-template-columns: 1fr; }
    .photostream-page .field-notes-interlude--qa .field-notes-interlude__heading,
    .photostream-page .field-notes-interlude--qa .field-notes-interlude__item { grid-column: 1; grid-row: auto; }
    .photostream-page .field-notes-interlude--staggered .field-notes-interlude__item:nth-child(3) { grid-column: 1; }
    .photostream-page .field-notes-interlude--qa .field-notes-interlude__heading { display: flex; align-items: baseline; justify-content: space-between; gap: .75rem; flex-wrap: wrap; }
    .photostream-page .field-notes-interlude__topic { margin-top: 0; }
  }
</style>
