---
import Layout from '../layouts/Layout.astro';
import ProjectCard from './ProjectCard.astro';
import Heading from './Heading.astro';
import { categoriesForStory, subtitleForStory, thumbnailForStory } from '../lib/story-metadata';
import type { CollectionEntry } from 'astro:content';
interface Props { stories: CollectionEntry<'stories'>[]; currentPage: number; totalPages: number; category?: string; }
const { stories: sorted, currentPage, totalPages, category = 'all' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const categoryOrder = ['animals', 'pet sessions', 'adventures', 'live music'];
const categorySlug = (value: string) => value.toLowerCase().replace(/\s+/g, '-');
const pageRoot = category === 'all' ? `${base}posts/` : `${base}categories/${category}/`;
const pageUrl = (n: number) => n === 1 ? pageRoot : `${pageRoot}${n}/`;
---
<Layout title="All Posts">
  <header class="archive-header">
    <Heading>All Posts</Heading>
    <div class="archive-filters" aria-label="Filter posts">
      <a href={`${base}posts/`} class:list={{'is-active':category === 'all'}} aria-current={category === 'all' ? 'page' : undefined}>All</a>
      {categoryOrder.map(item => <a href={`${base}categories/${categorySlug(item)}/`} class:list={{'is-active':category === categorySlug(item)}} aria-current={category === categorySlug(item) ? 'page' : undefined}><span class="archive-filter-full">{item}</span><span class="archive-filter-mobile">{item === 'pet sessions' ? 'Pets' : item === 'live music' ? 'Music' : item}</span></a>)}
    </div>
  </header>
  <main>
    <div class="stories-grid stories-grid--archive" id="posts">
      {sorted.map((story) => {
        const cover = thumbnailForStory(story.id, story.data.coverImage || story.data.photos[0]);
        const archiveCover = story.id === 'world-of-owls'
          ? '/photos/world-of-owls/011-ph_lqfa3al2vfqnk4ie.jpg'
          : story.id === 'cat-colony-of-cala-bona'
            ? '/videos/kitten-cala-bona-poster.jpg'
          : story.id === 'a-story-of-ice-and-fire'
            ? '/videos/storyboard-reflections-poster.jpg'
          : story.id === 'dubrovnik-and-cavtat'
            ? '/videos/dubrovnik-harbour-poster.jpg'
          : story.id === 'roaming-rome'
            ? '/videos/trevi-fountain-poster.jpg'
          : story.id === 'vegas-baby'
            ? '/videos/vegas-neon-poster.jpg'
          : cover;
        const archiveVideo = story.id === 'wild-ireland'
          ? 'videos/wolf-looking-toward-camera.mp4'
          : story.id === 'world-of-owls'
            ? 'videos/eagle-world-of-owls.mp4'
            : story.id === 'cat-colony-of-cala-bona'
              ? 'videos/kitten-cala-bona.mp4'
            : story.id === 'a-story-of-ice-and-fire'
              ? 'videos/storyboard-reflections.mp4'
            : story.id === 'dubrovnik-and-cavtat'
              ? 'videos/dubrovnik-harbour.mp4'
            : story.id === 'roaming-rome'
              ? 'videos/trevi-fountain.mp4'
            : story.id === 'vegas-baby'
              ? 'videos/vegas-neon.mp4'
            : undefined;
        const categories = categoriesForStory(story.id, story.data.categories);
        const subtitle = subtitleForStory(story.id, story.data.subtitle);
        return <ProjectCard
          href={`${base}stories/${story.id}`}
          image={archiveCover ? `${base}${archiveCover.replace(/^\//, '')}` : undefined}
          video={archiveVideo ? `${base}${archiveVideo}` : undefined}
          videoPosition={story.id === 'wild-ireland' ? 'center 20%' : undefined}
          title={story.data.title}
          type={story.data.type}
          caption={subtitle}
          categories={categories}
        />;
      })}
    </div>
    {totalPages > 1 && <nav class="archive-pagination" aria-label="Stories pages">
      {currentPage > 1 && <a href={pageUrl(currentPage - 1)} rel="prev">← Previous</a>}
      {Array.from({length: totalPages}, (_, i) => i + 1).map(n => n === currentPage ? <span aria-current="page">{n}</span> : <a href={pageUrl(n)} aria-label={`Page ${n}`}>{n}</a>)}
      {currentPage < totalPages && <a href={pageUrl(currentPage + 1)} rel="next">Next →</a>}
    </nav>}
  </main>
</Layout>
<script>
  // Preserve old bookmarked category query links.
  const legacy = new URLSearchParams(location.search).get('category');
  const allowed = ['animals','pet-sessions','adventures','live-music'];
  if (legacy && allowed.includes(legacy)) location.replace(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}categories/${legacy}/`);
</script>
