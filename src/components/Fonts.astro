---
import '../styles/buttons.css';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const faces = [
  ['Cambon', 'cambon-regular-webfont.woff2', 400],
  ['Cambon', 'cambon-semibold-webfont.woff2', 600],
  ['Fakt Pro', 'FaktPro-Normal.woff2', 400],
  ['Fakt Pro', 'FaktPro-SemiBold.woff2', 600],
];
const css = faces.map(([family, file, weight]) =>
  `@font-face { font-family: '${family}'; src: url('${base}fonts/${file}') format('woff2'); font-display: swap; font-style: normal; font-weight: ${weight}; }`
).join('\n') + [400, 600].map(weight => {
  const file = weight === 600 ? 'FaktPro-SemiBold.woff2' : 'FaktPro-Normal.woff2';
  // Fakt: 1000 units/em, caps 688. hhea uses 1012/-313, whereas OS/2
  // USE_TYPO_METRICS uses 748/-252. The latter raises capitals by ~.096em.
  // 84.4% - 15.6% = 68.8%: capital ink is centred, with a 1em line box.
  // Unsupported descriptors are ignored; the original hhea is already close.
  return `@font-face { font-family: 'Fakt Pro UI'; src: url('${base}fonts/${file}') format('woff2'); font-display: swap; font-style: normal; font-weight: ${weight}; ascent-override: 84.4%; descent-override: 15.6%; line-gap-override: 0%; }`;
}).join('\n');
---
<style is:inline set:html={css} />
