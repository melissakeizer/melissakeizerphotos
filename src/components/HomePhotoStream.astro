---
import CameraDrawing from './CameraDrawing.astro';
import Heading from './Heading.astro';
import { fieldNotes } from '../lib/field-notes';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const photoUrl = (path: string) => base + path.replace(/^\//, '');
const picks = ['auditt.jpg', 'pale-waves-belfast.jpg', 'orca-castle-park.jpg', 'barcelona-parakeet.jpeg'];
const previewPhotos = picks.map(image => fieldNotes.find(note => note.image === image)).filter((note): note is NonNullable<typeof note> => Boolean(note));
---
<div class="photostream-home-strip">
    <section class="home-field-notes home-field-notes--preview home-field-notes--light-preview" id="field-notes" aria-labelledby="field-notes-title">
      <div class="home-field-notes__phone" aria-hidden="true">
        <CameraDrawing variant="phone" />
      </div>
      <div class="home-field-notes__intro">
        <Heading as="h2" id="field-notes-title">PhotoStream</Heading>
        <p>Small moments and everyday frames without a bigger story.</p>
        <a class="home-text-link" href={`${base}photostream/`}>Browse PhotoStream <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-field-notes__grid">
        {previewPhotos.map((fieldNote) => (
          <figure class="field-note-card">
            <img src={photoUrl(`/photos/00-photostream/${fieldNote.image}`)} alt={fieldNote.title} loading="lazy" decoding="async" />
            <figcaption>
              <Heading as="h4">{fieldNote.title}</Heading>
              <span>{fieldNote.camera ? `${fieldNote.camera}${fieldNote.lens ? ` · ${fieldNote.lens}` : ''}` : fieldNote.metadataNote || fieldNote.date}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
</div>
<style>
.photostream-home-strip { --color-text: #1a1918; --color-muted: #6b6560; color: #1a1918; }
</style>
