---
import Photo from './Photo.astro';
import { storyCardMedia } from '../lib/story-card-media';
import Heading from './Heading.astro';
interface Props {
  href: string;
  image?: string;
  video?: string;
  videoPosition?: string;
  title: string;
  type: string;
  caption?: string | null;
  categories?: string[];
}

const { href, title, type, caption, categories } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const slug = href.split('/stories/')[1]?.replace(/\/$/, '');
const media = slug ? storyCardMedia[slug] : undefined;
const image = media ? `${base}${media.image}` : Astro.props.image;
const video = media ? (media.video ? `${base}${media.video}` : undefined) : Astro.props.video;
const videoPosition = media?.position ?? Astro.props.videoPosition;
---

<article class="project-card" data-categories={categories?.join('|')}>
  <a href={href}>
    <div class="project-card__image" data-video-state={video ? 'pending' : undefined}>
      {image && <Photo src={image} alt={title} sizes="(max-width: 600px) 46vw, (max-width: 1280px) 45vw, 30vw" style={videoPosition ? `object-position: ${videoPosition}` : undefined} loading="lazy" decoding="async" />}
      {video && <video class="project-card__video" src={video} style={videoPosition ? `object-position: ${videoPosition}` : undefined} muted loop playsinline webkit-playsinline preload="none" aria-hidden="true"></video>}
    </div>
    <div class="project-card__content">
      <Heading as="h3">{title}</Heading>
      {caption && <p class="project-card__caption">{caption}</p>}
      <p class="project-card__type">{type}</p>
    </div>
  </a>
</article>

<script>
  import { createCardVideo } from '../lib/card-video.mjs';
  clearTimeout((window as Window & { cardVideoFallback?: number }).cardVideoFallback);
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const controllers = new Map<HTMLVideoElement, ReturnType<typeof createCardVideo>>();
  const observer = 'IntersectionObserver' in window ? new IntersectionObserver(entries => {
    entries.forEach(entry => controllers.get(entry.target as HTMLVideoElement)?.setVisible(entry.isIntersecting));
  }, { rootMargin: '100px' }) : undefined;
  document.querySelectorAll<HTMLVideoElement>('.project-card__video').forEach(video => {
    const controller = createCardVideo(video, { reducedMotion: () => motion.matches, pageVisible: () => !document.hidden });
    controllers.set(video, controller);
    if (observer) observer.observe(video);
    else controller.setVisible(true);
  });
  document.addEventListener('visibilitychange', () => controllers.forEach(controller => controller.sync()));
  // Power-saving/autoplay policies can allow playback after a real interaction.
  document.addEventListener('pointerup', () => controllers.forEach(controller => controller.retry()), { passive: true });
  document.addEventListener('keydown', () => controllers.forEach(controller => controller.retry()));
  const changed = () => controllers.forEach(controller => controller.sync());
  if (motion.addEventListener) motion.addEventListener('change', changed);
  else motion.addListener(changed);
</script>

<style>
  .project-card__type { transition: border-color .25s ease; }
  .project-card a:hover .project-card__type,
  .project-card a:focus-visible .project-card__type { border-top-color: var(--color-text); }
  .project-card__image video { opacity: 0; transition: transform .4s ease; }
  :global(html.video-autoplay-enabled) .project-card__image[data-video-state="pending"] > img { opacity: 0; }
  .project-card__image[data-video-state="playing"] > img { visibility: hidden; }
  .project-card__image[data-video-state="playing"] video { opacity: 1; }
  .project-card a:hover :is(img, video),
  .project-card a:focus-visible :is(img, video) { transform: scale(1.02); }
  @media (prefers-reduced-motion: reduce) {
    :global(html.video-autoplay-enabled) .project-card__image[data-video-state] > img { opacity: 1; visibility: visible; }
    .project-card a:hover :is(img, video),
    .project-card a:focus-visible :is(img, video) { transform: none; }
    .project-card__image :is(img, video), .project-card__type { transition: none; }
  }
</style>
