---
import { storyCardMedia } from '../lib/story-card-media';
import Heading from './Heading.astro';
interface Props {
  href: string;
  image?: string;
  video?: string;
  videoPosition?: string;
  title: string;
  type: string;
  caption?: string | null;
  categories?: string[];
}

const { href, title, type, caption, categories } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const slug = href.split('/stories/')[1]?.replace(/\/$/, '');
const media = slug ? storyCardMedia[slug] : undefined;
const image = media ? `${base}${media.image}` : Astro.props.image;
const video = media ? (media.video ? `${base}${media.video}` : undefined) : Astro.props.video;
const videoPosition = media?.position ?? Astro.props.videoPosition;
---

<article class="project-card" data-categories={categories?.join('|')}>
  <a href={href}>
    <div class="project-card__image">
      {image && <img src={image} alt={title} loading="lazy" decoding="async" />}
      {video && <video class="project-card__video" src={video} poster={image} style={videoPosition ? `object-position: ${videoPosition}` : undefined} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>}
    </div>
    <div class="project-card__content">
      <Heading as="h3">{title}</Heading>
      {caption && <p class="project-card__caption">{caption}</p>}
      <p class="project-card__type">{type}</p>
    </div>
  </a>
</article>
