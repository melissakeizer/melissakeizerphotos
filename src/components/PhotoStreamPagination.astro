---
interface Props { currentPage: number; totalPages: number; }
const { currentPage, totalPages } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const pageUrl = (page: number) => `${base}photostream/${page === 1 ? '' : `${page}/`}`;
---
{totalPages > 1 && <nav class="photostream-pagination" id="photostream-pages" aria-label="PhotoStream pages">
  {currentPage > 1 && <a href={pageUrl(currentPage - 1)} rel="prev" aria-label="Previous page">←</a>}
  {Array.from({ length: totalPages }, (_, index) => index + 1).map(page => page === currentPage
    ? <span aria-current="page" aria-label={`Page ${page}, current page`}>{page}</span>
    : <a href={pageUrl(page)} aria-label={`Page ${page}`}>{page}</a>)}
  {currentPage < totalPages && <a href={pageUrl(currentPage + 1)} rel="next" aria-label="Next page">→</a>}
</nav>}

<style>
  .photostream-pagination { grid-column: 5 / -1; display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; margin-top: clamp(3rem, 5vw, 5rem); }
  .photostream-pagination a, .photostream-pagination span { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; height: 44px; padding: 0 10px; border: 1px solid transparent; border-radius: 0; color: #f3f0e9; font: 600 .85rem/1 var(--font-sans); text-decoration: none; transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease; }
  .photostream-pagination [aria-current="page"] { border-color: #f3f0e9; }
  .photostream-pagination a:hover, .photostream-pagination a:focus-visible { color: #11110f; background: var(--color-yellow); border-color: var(--color-yellow); }
  .photostream-pagination a:focus-visible { outline: 2px solid var(--color-yellow); outline-offset: 3px; }
  @media (max-width: 900px) { .photostream-pagination { grid-column: 1 / -1; } }
  @media (prefers-reduced-motion: reduce) { .photostream-pagination a { transition: none; } }
</style>
