---
interface Props {
  as?: 'h1' | 'h2' | 'h3' | 'h4';
  size?: 'h1' | 'h2' | 'h3' | 'h4' | 'story-hero';
  id?: string;
  class?: string;
}
const { as: Tag = 'h1', size = Tag, id, class: className } = Astro.props;
---
<Tag id={id} class:list={['type-heading', `type-heading--${size}`, className]}><slot /></Tag>
