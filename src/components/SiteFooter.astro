---
import CameraDrawing from './CameraDrawing.astro';
import Heading from './Heading.astro';
import Photo from './Photo.astro';
const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');
---

<footer class="site-footer" id="contact" style={`--footer-photo: url('${base}photos/road-to-sligo/000-photo.jpg')`}>
  <div class="site-footer__panel">
    <div class="site-footer__portrait">
      <Photo src={`${base}melissa-keizer-avatar.jpeg`} alt="Melissa Keizer" sizes="120px" loading="lazy" />
    </div>
    <div class="site-footer__introduction">
      <Heading as="h2" size="h4">Hi, I’m Melissa Keizer.</Heading>
      <p class="project-card__caption">I’m a photographer and product designer based in Bangor, Northern Ireland. Usually found following dogs into good light or making one more tiny adjustment in Lightroom.</p>
    </div>
    <div class="site-footer__navigation">
      <p class="site-footer__label">Explore</p>
      <nav class="site-footer__links" aria-label="Explore and social media">
        <a href={base}>Home</a>
        <a href={`${base}posts/`}>All posts</a>
        <a href={`${base}photostream/`}>PhotoStream</a>
        <a href={`${base}privacy/`}>Privacy</a>
        <a href="mailto:hi@melissakeizer.com">Email</a>
        <a href="https://www.linkedin.com/in/melissakeizer/" target="_blank" rel="noreferrer">LinkedIn</a>
        <a href="https://www.instagram.com/KeizGoesBoom/" target="_blank" rel="noreferrer">Instagram</a>
        <a href="https://unsplash.com/@KeizGoesBoom" target="_blank" rel="noreferrer">Unsplash</a>
      </nav>
    </div>
    <div class="site-footer__equipment-space" aria-hidden="true">
      <CameraDrawing variant="lens" id="footer-lens-pencil" duration={7} />
    </div>
  </div>
</footer>

<style>
  .site-footer__navigation.is-compact > .site-footer__label { display: none; }
</style>
<script>
  const navigation = document.querySelector<HTMLElement>('.site-footer__navigation');
  const links = navigation?.querySelector<HTMLElement>('.site-footer__links');
  if (navigation && links) {
    const measure = () => {
      // Restore the label only for measurement, then hide it before paint if
      // keeping it would force links onto another line (or into overflow).
      navigation.classList.remove('is-compact');
      const items = [...links.querySelectorAll('a')];
      const gap = parseFloat(getComputedStyle(links).columnGap) || 0;
      const required = items.reduce((sum, item) => sum + item.getBoundingClientRect().width, 0) + gap * Math.max(0, items.length - 1);
      navigation.classList.toggle('is-compact', required > links.clientWidth + 1);
    };
    if ('ResizeObserver' in window) new ResizeObserver(measure).observe(navigation);
    else window.addEventListener('resize', measure, { passive: true });
    document.fonts?.ready.then(measure);
    measure();
  }
</script>
