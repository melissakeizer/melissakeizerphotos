---
import cameraSource from '../../public/camera-pencil-traced.svg?raw';
import phoneSource from '../../public/phone-pencil-traced.svg?raw';
import fullPhoneSource from '../../public/phone-full-pencil.svg?raw';
import lensSource from '../../public/lens-pencil-traced.svg?raw';
import { phoneStrokes, phoneAccents, fullPhoneStrokes } from '../lib/phone-drawing';
import { lensStrokes, lensAccents } from '../lib/lens-drawing';
import { cameraStrokes, cameraAccents, cameraDrawingDuration, cameraDrawingTimeScale } from '../lib/camera-drawing';
import { cameraRightEdge } from '../lib/camera-right-edge';
import { drawingLayer } from '../../scripts/web-media.mjs';

interface Props { id?: string; variant?: 'camera' | 'phone' | 'phone-full' | 'lens'; duration?: number; }
const { variant = 'camera', id = `home-${variant}-pencil`, duration = cameraDrawingDuration } = Astro.props;
// Scale the entire stroke sequence, including its final grain reveal, together.
const timeScale = cameraDrawingTimeScale * duration / cameraDrawingDuration;
const drawings = {
  camera: { source: cameraSource, strokes: cameraStrokes, accents: cameraAccents, width: 1664, height: 1024, viewBox: '0 0 1536 1024' },
  phone: { source: phoneSource, strokes: phoneStrokes, accents: phoneAccents, width: 1230, height: 1278, viewBox: '0 0 1230 1278' },
  'phone-full': { source: fullPhoneSource, strokes: fullPhoneStrokes, accents: phoneAccents, width: 1230, height: 2160, viewBox: '140 235 950 1900' },
  lens: { source: lensSource, strokes: lensStrokes, accents: lensAccents, width: 1420, height: 1108, viewBox: '0 0 1420 1108' },
};
const { source, strokes, accents, width, height, viewBox } = drawings[variant];
const graphite = source.match(/<g id="graphite"[\s\S]*?<\/g>/)?.[0]?.replace('id="graphite"', `id="${id}-graphite-art"`) ?? '';
const yellow = source.match(/<g id="yellow-accents"[\s\S]*?<\/g>/)?.[0]?.replace('id="yellow-accents"', `id="${id}-yellow-art"`) ?? '';
if (!graphite || !yellow) throw new Error('Camera pencil SVG is missing its artwork layers.');
// Keep the same vectors and animated masks; cache artwork once across pages.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const graphiteUrl = base + await drawingLayer(graphite.replace(`id="${id}-graphite-art"`, 'id="graphite"') + (variant === 'camera' ? cameraRightEdge : ''), width, height);
const yellowUrl = base + await drawingLayer(yellow.replace(`id="${id}-yellow-art"`, 'id="yellow-accents"'), width, height);
---
<svg
  xmlns:xlink="http://www.w3.org/1999/xlink"
  class="pencil-camera"
  viewBox={viewBox}
  aria-hidden="true"
  focusable="false"
  data-pencil-camera
  data-drawing={variant}
  data-duration={duration}
  style={`--drawing-speed:${timeScale}`}
>
  <defs>
    <mask id={`${id}-graphite`} maskUnits="userSpaceOnUse" x="0" y="0" width={width} height={height} style="mask-type: luminance">
      {strokes.map(stroke => (
        <path class="pencil-camera__pen" d={stroke.d} pathLength="1" fill="none" stroke="white" stroke-width={stroke.width} stroke-linecap="round" stroke-linejoin="round" data-phase={stroke.phase} style={`--pen-start:${stroke.start}s;--pen-time:${stroke.duration}s`} />
      ))}
      {/* Only the faint residual grain fills at the end; this is the same SVG,
          never a crossfade to a different drawing or a replacement PNG. */}
      <rect class="pencil-camera__finish" width={width} height={height} fill="white" />
    </mask>
    <mask id={`${id}-yellow`} maskUnits="userSpaceOnUse" x="0" y="0" width={width} height={height} style="mask-type: luminance">
      {accents.map(stroke => (
        <path class="pencil-camera__pen" d={stroke.d} pathLength="1" fill="none" stroke="white" stroke-width={stroke.width} stroke-linecap="round" stroke-linejoin="round" data-phase={stroke.phase} style={`--pen-start:${stroke.start}s;--pen-time:${stroke.duration}s`} />
      ))}
      <rect class="pencil-camera__finish" width={width} height={height} fill="white" />
    </mask>
  </defs>
  <g class="pencil-camera__art" mask={`url(#${id}-graphite)`}><image href={graphiteUrl} xlink:href={graphiteUrl} x="0" y="0" width={width} height={height} /></g>
  <g class="pencil-camera__art" mask={`url(#${id}-yellow)`}><image href={yellowUrl} xlink:href={yellowUrl} x="0" y="0" width={width} height={height} /></g>
</svg>

<style>
  .pencil-camera { display: block; width: 100%; height: auto; }
  /* The raster trace ended mid-eyelet at x=1536. Let the completed pencil edge
     extend beyond that canvas without rescaling or repositioning the camera. */
  .pencil-camera[data-drawing="camera"] { overflow: visible; }
  .pencil-camera__pen { stroke-dasharray: 1; stroke-dashoffset: 0; }
  /* Without JS the fully drawn vector stays visible. JS enables the replay
     only after the component is in view. */
  :global(.camera-draw-enabled) .pencil-camera__pen {
    stroke-dashoffset: 1;
    animation: pencil-stroke calc(var(--pen-time) * var(--drawing-speed)) linear calc(var(--pen-start) * var(--drawing-speed)) both;
    animation-play-state: paused;
  }
  :global(.camera-draw-enabled) .pencil-camera__finish {
    opacity: 0;
    animation: pencil-finish calc(.9s * var(--drawing-speed)) ease-in calc(15.3s * var(--drawing-speed)) both;
    animation-play-state: paused;
  }
  :global(.camera-draw-enabled) .pencil-camera.is-playing .pencil-camera__pen,
  :global(.camera-draw-enabled) .pencil-camera.is-playing .pencil-camera__finish {
    animation-play-state: running;
  }
  .pencil-camera.is-complete .pencil-camera__art { mask: none; }
  @keyframes pencil-stroke { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes pencil-finish { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.camera-draw-enabled) .pencil-camera__pen,
    :global(.camera-draw-enabled) .pencil-camera__finish { animation: none; }
    .pencil-camera .pencil-camera__art { mask: none; }
  }
</style>

<script>
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  function setupCamera(svg: SVGSVGElement) {
    if (svg.dataset.ready) return;
    svg.dataset.ready = 'true';
    let observer: IntersectionObserver | undefined;
    const finish = () => {
      svg.classList.add('is-complete');
      // Completed mask animations no longer need to remain in the render tree.
      svg.querySelectorAll<SVGElement>('mask').forEach(mask => { mask.style.display = 'none'; });
    };
    const play = () => {
      if (motion.matches) return finish();
      svg.classList.add('is-playing');
      observer?.disconnect();
    };
    svg.querySelector('.pencil-camera__finish')?.addEventListener('animationend', finish, { once: true });
    if (motion.matches || !('IntersectionObserver' in window) || !document.documentElement.classList.contains('camera-draw-enabled')) finish();
    else {
      observer = new IntersectionObserver(entries => {
        if (entries.some(entry => entry.isIntersecting)) play();
      });
      observer.observe(svg);
    }
    const onMotionChange = (event: MediaQueryListEvent) => { if (event.matches) { observer?.disconnect(); finish(); } };
    if (motion.addEventListener) motion.addEventListener('change', onMotionChange);
    else motion.addListener(onMotionChange);
  }
  document.querySelectorAll<SVGSVGElement>('[data-pencil-camera]').forEach(setupCamera);
</script>
