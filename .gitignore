# Keep music originals locally; use optimized copies in the story.
/public/photos/portfolio-live-music/*
!/public/photos/portfolio-live-music/web/

# Private planning notes stay on this computer, outside the public repository.
/content-planning/ideas.json
/content-planning/ideas.json.tmp

# jetbrains setting folder
.idea/
