{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "melissa-photography-redirects",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "routes": [
    { "pattern": "melissakeizerphotography.com", "custom_domain": true, "zone_name": "melissakeizerphotography.com" },
    { "pattern": "www.melissakeizerphotography.com", "custom_domain": true, "zone_name": "melissakeizerphotography.com" }
  ]
}
